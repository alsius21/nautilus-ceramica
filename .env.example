# Feature flag — shop disabled by default (development). Set to true to expose botiga.
# PUBLIC_SHOP_ENABLED=false
PUBLIC_SHOP_ENABLED=false

# FormSubmit endpoint for "Peces disponibles" inquiry form (no backend needed).
# See https://formsubmit.co/ — no registration required.
# Set the destination email address; the form will POST to https://formsubmit.co/<email>.
# On first submit you'll receive a confirmation email to activate the form.
# Example: PUBLIC_FORMSUBMIT_EMAIL=info@nautilusceramica.com
PUBLIC_FORMSUBMIT_EMAIL=info@example.com

# Content provider — editorial data source (build-time only, never exposed to the client).
# `local` reads the versioned JSON in src/content/ (no code changes needed to edit texts).
# Future: `storyblok` | `sheets` (adapter to implement in src/lib/content.ts).
CONTENT_PROVIDER=local

# Use a different port in each worktree when running several dev servers.
PORT=4321