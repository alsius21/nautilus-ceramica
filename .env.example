# Feature flag — shop disabled by default (development). Set to true to expose botiga.
# PUBLIC_SHOP_ENABLED=false
PUBLIC_SHOP_ENABLED=false

# Formspree endpoint for "Peces disponibles" inquiry form (no backend needed).
# Create a form at https://formspree.io/forms and paste its URL here.
# Example: PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mwkavzxx
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xplaceholder

# Use a different port in each worktree when running several dev servers.
PORT=4321