---
import { BRAND_NAME } from '@/consts';
import { t, normalizeLocale } from '@/i18n';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/archivo';

interface Props {
	title?: string;
}

const { title: pageTitle } = Astro.props;

const locale = normalizeLocale(Astro.currentLocale);
const description = t(locale, 'meta.description');
const title = pageTitle ?? BRAND_NAME;

// Base path with a guaranteed trailing slash (e.g. `/nautilus-ceramica/`).
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle ? `${title} · ${BRAND_NAME}` : BRAND_NAME}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	:global(body) {
		font-family: 'Archivo Variable', system-ui, -apple-system, sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
</style>
