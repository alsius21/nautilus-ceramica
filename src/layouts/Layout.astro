---
import { BRAND_NAME } from '../consts';
import { t, normalizeLocale } from '../i18n';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/archivo';

const locale = normalizeLocale(Astro.currentLocale);
const description = t(locale, 'meta.description');

// Base path with a guaranteed trailing slash (e.g. `/nautilus-ceramica/`).
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<link rel="icon" href={`${base}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{BRAND_NAME}</title>
		<meta name="description" content={description} />
		<!-- PWA: installability, theme and iOS standalone chrome -->
		<link rel="manifest" href={`${base}manifest.webmanifest`} />
		<meta name="theme-color" content="#eee9e1" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content={BRAND_NAME} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<script src="/src/pwa.ts"></script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:global(html),
	:global(body) {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}

	:global(body) {
		font-family: 'Archivo Variable', system-ui, -apple-system, sans-serif;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
</style>