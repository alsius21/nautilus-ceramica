---
import Footer from '@/components/Footer.astro';
import { getCookies } from '@/lib/content';
import { t, normalizeLocale, locales } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
	/** Mode editor: converteix els textos en camps editables sobre la mateixa pàgina. */
	editable?: boolean;
}

const { editable = false } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const cookies = getCookies(locale);
const editHref = getRelativeLocaleUrl(
	locale,
	`/${t(locale, 'editor.path')}/${t(locale, 'editor.pages.path')}/${t(locale, 'editor.page.cookies.path')}`,
);
const editAttr = (path: string) => (editable ? path : undefined);
const editableAttr = editable ? 'true' : undefined;
---

<main class="legal">
	<header class="journal-header">
		<a class="back-link" href={getRelativeLocaleUrl(locale, '/')}>← {t(locale, 'cookie.back')}</a>
		<div class="header-end">
			{import.meta.env.DEV && <a class="edit-link" href={editHref}>{t(locale, 'editor.page')}</a>}
			<nav class="lang-switcher" aria-label={t(locale, 'lang.selector')}>
				{locales.map((code) => (
					<a
						href={getRelativeLocaleUrl(code, `/${t(code, 'cookie.path')}`)}
						class:list={['lang-link', { 'is-current': code === locale }]}
						aria-current={code === locale ? 'page' : null}
						title={t(code, 'lang.name')}
					>
						{code}
					</a>
				))}
			</nav>
		</div>
	</header>

	<article class="entry">
		<div class="entry-intro">
			<p class="eyebrow" data-edit={editAttr('eyebrow')} contenteditable={editableAttr}>{cookies.eyebrow}</p>
			<h1 data-edit={editAttr('title')} contenteditable={editableAttr}>{cookies.title}</h1>
			<p class="description" data-edit={editAttr('lead')} contenteditable={editableAttr}>{cookies.lead}</p>
		</div>

		<div class="statement">
			<section class="clause">
				<h2 data-edit={editAttr('s1.title')} contenteditable={editableAttr}>{cookies.s1.title}</h2>
				<p data-edit={editAttr('s1.body')} contenteditable={editableAttr}>{cookies.s1.body}</p>
			</section>
			<section class="clause">
				<h2 data-edit={editAttr('s2.title')} contenteditable={editableAttr}>{cookies.s2.title}</h2>
				<p data-edit={editAttr('s2.body')} contenteditable={editableAttr}>{cookies.s2.body}</p>
			</section>
			<section class="clause">
				<h2 data-edit={editAttr('s3.title')} contenteditable={editableAttr}>{cookies.s3.title}</h2>
				<p data-edit={editAttr('s3.body')} contenteditable={editableAttr}>{cookies.s3.body}</p>
			</section>
			<section class="clause">
				<h2 data-edit={editAttr('s4.title')} contenteditable={editableAttr}>{cookies.s4.title}</h2>
				<p data-edit={editAttr('s4.body')} contenteditable={editableAttr}>{cookies.s4.body}</p>
			</section>
			<section class="clause">
				<h2 data-edit={editAttr('s5.title')} contenteditable={editableAttr}>{cookies.s5.title}</h2>
				<p data-edit={editAttr('s5.body')} contenteditable={editableAttr}>{cookies.s5.body}</p>
			</section>
			<p class="updated">
				{t(locale, 'cookie.updated')} — <span data-edit={editAttr('updated')} contenteditable={editableAttr}>{cookies.updated}</span>
			</p>
		</div>
	</article>

	<Footer />
</main>

<style>
	.legal {
		--ink: #29251f;
		--paper: #e8e5dc;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		min-height: 100dvh;
		padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 6vw, 7rem) 0;
		background:
			linear-gradient(115deg, rgba(217, 232, 222, 0.78), transparent 42%),
			radial-gradient(ellipse at 80% 18%, rgba(191, 214, 200, 0.5), transparent 32%),
			var(--paper);
		color: var(--ink);
	}

	.journal-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
		padding-bottom: 1.25rem;
	}

	.header-end {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.back-link,
	.lang-link {
		color: color-mix(in srgb, var(--ink) 62%, transparent);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 240ms ease;
	}

	.back-link:hover,
	.back-link:focus-visible,
	.lang-link:hover,
	.lang-link:focus-visible,
	.lang-link.is-current {
		color: var(--ink);
	}

	.edit-link {
		color: color-mix(in srgb, var(--ink) 72%, transparent);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-decoration: none;
		border: 1px dashed color-mix(in srgb, var(--ink) 35%, transparent);
		border-radius: 999px;
		padding: 0.3rem 0.8rem;
		transition:
			color 240ms ease,
			border-color 240ms ease;
	}

	.edit-link:hover,
	.edit-link:focus-visible {
		color: var(--ink);
		border-color: var(--ink);
	}

	.lang-switcher {
		display: flex;
		gap: 1rem;
	}

	.entry {
		display: grid;
		grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(2rem, 8vw, 9rem);
		align-items: start;
		max-width: 110rem;
		width: 100%;
		margin: clamp(3rem, 9vw, 9rem) auto 0;
		padding-bottom: clamp(3rem, 8vw, 6rem);
	}

	.entry-intro {
		position: sticky;
		top: 2rem;
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 9ch;
		margin: 0;
		font-family: 'Fraunces Variable', Georgia, serif;
		font-size: clamp(3rem, 7vw, 7rem);
		font-weight: 400;
		font-optical-sizing: auto;
		font-variation-settings: 'SOFT' 40, 'WONK' 1;
		letter-spacing: -0.055em;
		line-height: 0.88;
	}

	.description {
		max-width: 34rem;
		margin: 2.5rem 0 0;
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		line-height: 1.6;
	}

	.statement {
		display: flex;
		flex-direction: column;
		gap: clamp(2.5rem, 5vw, 4rem);
		padding-top: clamp(2rem, 4vw, 3.5rem);
		border-top: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
	}

	.clause h2 {
		margin: 0 0 1rem;
		font-size: 0.68rem;
		font-weight: 400;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
	}

	.clause p {
		max-width: 34rem;
		margin: 0;
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		line-height: 1.6;
	}

	.updated {
		margin: clamp(1.5rem, 3vw, 2.5rem) 0 0;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
	}

	.legal :focus-visible {
		outline: 1px solid var(--ink);
		outline-offset: 0.35rem;
	}

	@media (max-width: 700px) {
		.entry {
			display: block;
			margin-top: 3.5rem;
		}

		.entry-intro {
			position: static;
			margin-bottom: 2.5rem;
		}

		h1 {
			max-width: 12ch;
		}
	}

	@media (prefers-color-scheme: dark) {
		.legal {
			--ink: var(--nc-ink-dark);
			--paper: var(--nc-paper-dark);
			background:
				linear-gradient(115deg, rgba(58, 92, 82, 0.42), transparent 42%),
				radial-gradient(ellipse at 80% 18%, rgba(72, 112, 96, 0.3), transparent 32%),
				var(--nc-paper-dark);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.back-link,
		.lang-link,
		.edit-link {
			transition: none;
		}
	}
</style>
