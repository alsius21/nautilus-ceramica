---
import Footer from '@/components/Footer.astro';
import { BRAND_NAME } from '@/consts';
import { t, normalizeLocale, locales } from '@/i18n';
import { works, workImageFiles } from '@/data/works';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = normalizeLocale(Astro.currentLocale);

// Base path with a guaranteed trailing slash (e.g. `/nautilus-ceramica/`), so
// public/ URLs below start from it instead of a bare leading slash.
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

// Chess piece featured on the home page (right-hand artwork).
const featured = works.find((work) => work.slug === 'dama')!;

const images = [
	{
		slug: works[0].slug,
		src: `${base}images/${workImageFiles[works[0].imageKeys[0]]}.webp`,
		alt: t(locale, 'art.plate'),
	},
	{
		slug: featured.slug,
		src: `${base}images/${workImageFiles[featured.imageKeys[0]]}.webp`,
		alt: t(locale, `work.${featured.imageKeys[0]}.alt` as Parameters<typeof t>[1]),
	},
];

---

<main class="home home-alt">
	<header class="masthead">
		<a class="brand-home" href={getRelativeLocaleUrl(locale, '/')} aria-label={BRAND_NAME}>
			<h1>{BRAND_NAME}</h1>
		</a>
		<div class="masthead-meta">
			<p class="eyebrow">Zara Castillo Martínez</p>
			<nav class="page-nav" aria-label={t(locale, 'nav.label')}>
				<a href={getRelativeLocaleUrl(locale, `/${t(locale, 'gallery.path')}`)}>{t(locale, 'nav.gallery')}</a>
				<a href={getRelativeLocaleUrl(locale, `/${t(locale, 'exhibitions.path')}`)}>{t(locale, 'nav.exhibitions')}</a>
			</nav>
			<nav class="lang-switcher" aria-label={t(locale, 'lang.selector')}>
				{locales.map((code) => (
					<a
						href={getRelativeLocaleUrl(code, '/')}
						class:list={['lang-link', { 'is-current': code === locale }]}
						aria-current={code === locale ? 'page' : null}
						title={t(code, 'lang.name')}
					>
						{code}
					</a>
				))}
			</nav>
		</div>
	</header>

	<section class="gallery" aria-label={t(locale, 'gallery.label')}>
		{images.map((image, index) => (
			<a class:list={["artwork", `artwork-${index + 1}`]} href={getRelativeLocaleUrl(locale, `/${t(locale, 'work.path')}/${image.slug}`)}>
				<figure>
				<img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} />
				</figure>
			</a>
		))}
	</section>

	<Footer />
</main>

<style>
	.home {
		--ink: #29251f;
		--paper: #eee9e1;
		display: flex;
		flex-direction: column;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 100vh;
		min-height: 100dvh;
		box-sizing: border-box;
		padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 6vw, 7rem) 0;
		background:
			radial-gradient(ellipse at 8% 20%, rgba(53, 126, 130, 0.18), transparent 35%),
			radial-gradient(ellipse at 88% 78%, rgba(38, 76, 112, 0.15), transparent 38%),
			var(--paper);
		color: var(--ink);
	}

	.home::before,
	.home::after {
		position: absolute;
		z-index: -1;
		content: '';
		pointer-events: none;
	}

	.home-alt {
		background:
			linear-gradient(115deg, rgba(217, 232, 222, 0.78), transparent 42%),
			radial-gradient(ellipse at 80% 18%, rgba(191, 214, 200, 0.5), transparent 32%),
			#e8e5dc;
	}

	.home-alt::before {
		top: 12%;
		left: -12%;
		width: 125%;
		height: 18rem;
		border-radius: 48% 52% 44% 56% / 62% 40% 60% 38%;
		background:
			linear-gradient(95deg, transparent 8%, rgba(91, 147, 137, 0.2) 30%, rgba(255, 255, 255, 0.62) 48%, rgba(82, 132, 127, 0.22) 70%, transparent 90%);
		filter: blur(18px);
		transform: rotate(-7deg);
		animation-name: celadon-flow;
	}

	.home-alt::after {
		right: -12%;
		bottom: 3%;
		width: 85%;
		height: 20rem;
		border-radius: 61% 39% 54% 46% / 44% 63% 37% 56%;
		background:
			radial-gradient(ellipse at 40% 52%, rgba(109, 164, 151, 0.38), transparent 47%),
			radial-gradient(ellipse at 72% 46%, rgba(241, 221, 181, 0.4), transparent 42%);
		filter: blur(30px);
		transform: rotate(12deg);
		animation-name: celadon-flow;
		animation-duration: 25s;
	}

	.masthead {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
		padding-bottom: 1.25rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.masthead-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
		text-align: right;
	}

	.lang-switcher {
		display: flex;
		gap: 1rem;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.lang-link {
		color: color-mix(in srgb, var(--ink) 55%, transparent);
		text-decoration: none;
		transition: color 240ms ease;
	}

	.lang-link:hover,
	.lang-link:focus-visible {
		color: var(--ink);
	}

	.lang-link.is-current {
		color: var(--ink);
	}

	.page-nav {
		display: flex;
		gap: 1rem;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	.page-nav a {
		color: color-mix(in srgb, var(--ink) 55%, transparent);
		text-decoration: none;
		transition: color 240ms ease;
	}

	.page-nav a:hover,
	.page-nav a:focus-visible {
		color: var(--ink);
	}

	.brand-home {
		color: inherit;
		text-decoration: none;
	}

	h1 {
		margin: 0;
		font-family: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
		font-size: clamp(2rem, 5vw, 5rem);
		font-weight: 400;
		font-optical-sizing: auto;
		font-variation-settings: 'SOFT' 40, 'WONK' 1;
		letter-spacing: -0.055em;
		line-height: 0.9;
	}

	.gallery {
		display: grid;
		flex: 1 0 auto;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: clamp(1rem, 3vw, 3.5rem);
		align-items: start;
		max-width: 110rem;
		margin: clamp(2rem, 7vw, 7rem) auto 0;
		padding-bottom: clamp(3rem, 8vw, 6rem);
	}

	.artwork {
		color: inherit;
		display: block;
		margin: 0;
		text-decoration: none;
	}

	.artwork figure {
		margin: 0;
		background: #dcd5ca;
		overflow: hidden;
	}

	.artwork-2 {
		margin-top: clamp(3rem, 12vw, 12rem);
	}

	.artwork img {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.artwork:hover img {
		transform: scale(1.025);
	}

	.artwork:focus-visible,
	.lang-link:focus-visible,
	.page-nav a:focus-visible,
	.brand-home:focus-visible {
		outline: 1px solid var(--ink);
		outline-offset: 0.35rem;
	}

	@media (max-width: 640px) {
		.masthead {
			display: block;
		}

		.masthead-meta {
			align-items: flex-start;
			text-align: left;
		}

		.gallery {
			display: block;
			margin-top: 2.5rem;
		}

		.artwork-2 {
			margin-top: 1.5rem;
		}
	}

	@media (prefers-color-scheme: dark) {
		.home {
			--ink: var(--nc-ink-dark);
			--paper: var(--nc-paper-dark);
			background:
				linear-gradient(115deg, rgba(58, 92, 82, 0.42), transparent 42%),
				radial-gradient(ellipse at 80% 18%, rgba(72, 112, 96, 0.3), transparent 32%),
				var(--nc-paper-dark);
		}

		.home-alt::before {
			background:
				linear-gradient(95deg, transparent 8%, rgba(97, 158, 146, 0.16) 30%, rgba(255, 255, 255, 0.07) 48%, rgba(88, 141, 135, 0.18) 70%, transparent 90%);
		}

		.home-alt::after {
			background:
				radial-gradient(ellipse at 40% 52%, rgba(116, 174, 160, 0.24), transparent 47%),
				radial-gradient(ellipse at 72% 46%, rgba(212, 178, 118, 0.18), transparent 42%);
		}

		.artwork figure {
			background: #2b2822;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home::before,
		.home::after {
			animation: none;
		}

		.artwork img {
			transition: none;
		}
	}

	@keyframes celadon-flow {
		from {
			transform: translate3d(-3%, 0, 0) rotate(-7deg) scaleY(0.96);
		}

		to {
			transform: translate3d(4%, 2%, 0) rotate(3deg) scaleY(1.08);
		}
	}
</style>
