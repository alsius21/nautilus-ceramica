---
import Footer from './Footer.astro';
import { BRAND_NAME } from '../consts';

const images = [
	{
		src: '/images/instagram/plato_en_taller_de_hoji.webp',
		alt: 'Ceramic plate in the Hoji workshop',
	},
	{
		src: '/images/instagram/exposicion_calabaza_en_llotja.webp',
		alt: 'Calabaza ceramic piece at an exhibition in Llotja',
	},
];

---

<main class="home home-alt">
	<header class="masthead">
		
		<h1>{BRAND_NAME}</h1>
	</header>

	<section class="gallery" aria-label="Selected work">
		{images.map((image, index) => (
			<figure class:list={["artwork", `artwork-${index + 1}`]}>
				<img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} />
			</figure>
		))}
	</section>

	<Footer />
</main>

<style>
	.home {
		--ink: #29251f;
		--paper: #eee9e1;
		display: flex;
		flex-direction: column;
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 100vh;
		min-height: 100dvh;
		box-sizing: border-box;
		padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 6vw, 7rem) 0;
		background:
			radial-gradient(ellipse at 8% 20%, rgba(53, 126, 130, 0.18), transparent 35%),
			radial-gradient(ellipse at 88% 78%, rgba(38, 76, 112, 0.15), transparent 38%),
			var(--paper);
		color: var(--ink);
	}

	.home::before,
	.home::after {
		position: absolute;
		z-index: -1;
		content: '';
		pointer-events: none;
	}

	.home-alt {
		background:
			linear-gradient(115deg, rgba(217, 232, 222, 0.78), transparent 42%),
			radial-gradient(ellipse at 80% 18%, rgba(191, 214, 200, 0.5), transparent 32%),
			#e8e5dc;
	}

	.home-alt::before {
		top: 12%;
		left: -12%;
		width: 125%;
		height: 18rem;
		border-radius: 48% 52% 44% 56% / 62% 40% 60% 38%;
		background:
			linear-gradient(95deg, transparent 8%, rgba(91, 147, 137, 0.2) 30%, rgba(255, 255, 255, 0.62) 48%, rgba(82, 132, 127, 0.22) 70%, transparent 90%);
		filter: blur(18px);
		transform: rotate(-7deg);
		animation-name: celadon-flow;
	}

	.home-alt::after {
		right: -12%;
		bottom: 3%;
		width: 85%;
		height: 20rem;
		border-radius: 61% 39% 54% 46% / 44% 63% 37% 56%;
		background:
			radial-gradient(ellipse at 40% 52%, rgba(109, 164, 151, 0.38), transparent 47%),
			radial-gradient(ellipse at 72% 46%, rgba(241, 221, 181, 0.4), transparent 42%);
		filter: blur(30px);
		transform: rotate(12deg);
		animation-name: celadon-flow;
		animation-duration: 25s;
	}

	.masthead {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
		padding-bottom: 1.25rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
		font-size: clamp(2rem, 5vw, 5rem);
		font-weight: 400;
		font-optical-sizing: auto;
		font-variation-settings: 'SOFT' 40, 'WONK' 1;
		letter-spacing: -0.055em;
		line-height: 0.9;
	}

	.gallery {
		display: grid;
		flex: 1 0 auto;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		gap: clamp(1rem, 3vw, 3.5rem);
		align-items: start;
		max-width: 110rem;
		margin: clamp(2rem, 7vw, 7rem) auto 0;
	}

	.artwork {
		margin: 0;
		background: #dcd5ca;
		overflow: hidden;
	}

	.artwork-2 {
		margin-top: clamp(3rem, 12vw, 12rem);
	}

	.artwork img {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.artwork:hover img {
		transform: scale(1.025);
	}

	@media (max-width: 640px) {
		.masthead {
			display: block;
		}

		.eyebrow {
			margin-bottom: 1rem;
		}

		.gallery {
			display: block;
			margin-top: 2.5rem;
		}

		.artwork-2 {
			margin-top: 1.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home::before,
		.home::after {
			animation: none;
		}

		.artwork img {
			transition: none;
		}
	}

	@keyframes celadon-flow {
		from {
			transform: translate3d(-3%, 0, 0) rotate(-7deg) scaleY(0.96);
		}

		to {
			transform: translate3d(4%, 2%, 0) rotate(3deg) scaleY(1.08);
		}
	}
</style>
