---
import Footer from '@/components/Footer.astro';
import { BRAND_NAME } from '@/consts';
import { works, workImageFiles } from '@/data/works';
import { t, normalizeLocale, locales } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = normalizeLocale(Astro.currentLocale);

// Base path with a guaranteed trailing slash (e.g. `/nautilus-ceramica/`), so
// public/ URLs below start from it instead of a bare leading slash.
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const images = works
	// The pumpkin has its own exhibition feature (Argillà 2026); keep it out of
	// the general gallery grid so it only appears via the exhibitions section.
	.filter((work) => work.slug !== 'calabaza-a-la-llotja')
	.map((work) => ({
		slug: work.slug,
		src: `${base}images/${workImageFiles[work.imageKeys[0]]}.webp`,
		alt: t(locale, `work.${work.imageKeys[0]}.alt` as Parameters<typeof t>[1]),
	}));
---

<main class="portfolio">
	<header class="journal-header">
		<a class="brand-name" href={getRelativeLocaleUrl(locale, '/')}>{BRAND_NAME}</a>
		<nav class="lang-switcher" aria-label={t(locale, 'lang.selector')}>
			{locales.map((code) => (
				<a
					href={getRelativeLocaleUrl(code, `/${t(code, 'gallery.path')}`)}
					class:list={['lang-link', { 'is-current': code === locale }]}
					aria-current={code === locale ? 'page' : null}
					title={t(code, 'lang.name')}
				>
					{code}
				</a>
			))}
		</nav>
	</header>

	<article class="entry">
		<div class="entry-intro">
			<p class="eyebrow">{t(locale, 'gallery.page.eyebrow')}</p>
			<h1>{t(locale, 'gallery.page.title')}</h1>
			<p class="description">{t(locale, 'gallery.page.description')}</p>
		</div>
		<section class="work-grid" aria-label={t(locale, 'nav.gallery')}>
			{images.map((image, index) => (
				<a class="artwork" href={getRelativeLocaleUrl(locale, `/${t(locale, 'work.path')}/${image.slug}`)}>
					<figure>
						<img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} />
					</figure>
				</a>
			))}
		</section>
	</article>

	<Footer />
</main>

<style>
	.portfolio {
		--ink: #29251f;
		--paper: #e8e5dc;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		min-height: 100dvh;
		padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 6vw, 7rem) 0;
		background:
			linear-gradient(115deg, rgba(217, 232, 222, 0.78), transparent 42%),
			radial-gradient(ellipse at 80% 18%, rgba(191, 214, 200, 0.5), transparent 32%),
			var(--paper);
		color: var(--ink);
	}

	.journal-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 2rem;
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
		padding-bottom: 1.25rem;
	}

	.brand-name {
		color: color-mix(in srgb, var(--ink) 85%, transparent);
		font-family: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
		font-size: clamp(1.15rem, 2.4vw, 1.75rem);
		font-weight: 400;
		font-optical-sizing: auto;
		font-variation-settings: 'SOFT' 40, 'WONK' 1;
		letter-spacing: -0.05em;
		line-height: 0.9;
		text-decoration: none;
		transition: color 240ms ease;
	}

	.lang-link {
		color: color-mix(in srgb, var(--ink) 62%, transparent);
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-decoration: none;
		text-transform: uppercase;
		transition: color 240ms ease;
	}

	.brand-name:hover,
	.brand-name:focus-visible,
	.lang-link:hover,
	.lang-link:focus-visible,
	.lang-link.is-current {
		color: var(--ink);
	}

	.lang-switcher {
		display: flex;
		gap: 1rem;
	}

	.entry {
		display: grid;
		grid-template-columns: minmax(14rem, 0.65fr) minmax(0, 1.35fr);
		gap: clamp(2rem, 8vw, 9rem);
		align-items: start;
		max-width: 110rem;
		width: 100%;
		margin: clamp(3rem, 9vw, 9rem) auto 0;
		padding-bottom: clamp(3rem, 8vw, 6rem);
	}

	.entry-intro {
		position: sticky;
		top: 2rem;
	}

	.eyebrow {
		margin: 0 0 1.5rem;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 9ch;
		margin: 0;
		font-family: 'Fraunces Variable', Georgia, serif;
		font-size: clamp(3rem, 7vw, 7rem);
		font-weight: 400;
		font-optical-sizing: auto;
		font-variation-settings: 'SOFT' 40, 'WONK' 1;
		letter-spacing: -0.055em;
		line-height: 0.88;
	}

	.description {
		max-width: 34rem;
		margin: 2.5rem 0 0;
		font-size: clamp(1rem, 1.5vw, 1.25rem);
		line-height: 1.6;
	}

	.work-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
		gap: clamp(1rem, 3vw, 3.5rem);
		align-items: start;
	}

	.artwork {
		color: inherit;
		display: block;
		margin: 0;
		text-decoration: none;
	}

	.artwork figure {
		margin: 0;
		background: #dcd5ca;
		overflow: hidden;
	}

	.artwork img {
		display: block;
		width: 100%;
		height: auto;
		transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.artwork:hover img {
		transform: scale(1.025);
	}

	.portfolio :focus-visible {
		outline: 1px solid var(--ink);
		outline-offset: 0.35rem;
	}

	@media (max-width: 700px) {
		.entry {
			display: block;
			margin-top: 3.5rem;
		}

		.entry-intro {
			position: static;
			margin-bottom: 2.5rem;
		}

		h1 {
			max-width: 12ch;
		}
	}

	@media (prefers-color-scheme: dark) {
		.portfolio {
			--ink: var(--nc-ink-dark);
			--paper: var(--nc-paper-dark);
			background:
				linear-gradient(115deg, rgba(58, 92, 82, 0.42), transparent 42%),
				radial-gradient(ellipse at 80% 18%, rgba(72, 112, 96, 0.3), transparent 32%),
				var(--nc-paper-dark);
		}

		.artwork figure {
			background: #2b2822;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.work-grid img,
		.brand-name,
		.lang-link {
			transition: none;
		}
	}
</style>