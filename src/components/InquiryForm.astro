---
import { t, normalizeLocale } from '@/i18n';
import { works, getSlug } from '@/data/works';

interface Props {
  preselectedSlug?: string;
  compact?: boolean;
  hideHeader?: boolean;
  hidePieces?: boolean;
}

const { preselectedSlug, compact = false, hideHeader = false, hidePieces = false } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);

// FORMSPREE: replace with your real endpoint or set via env.
// Create a form at https://formspree.io/ and paste the URL here.
// Example: https://formspree.io/f/mwkavzxx
const FORMSPREE_ENDPOINT = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? 'https://formspree.io/f/xplaceholder';

const pieceOptions = works
  .filter((w) => w.shop.available)
  .map((w) => ({
    slug: w.id,
    label: t(locale, `work.${w.titleKey}.title` as Parameters<typeof t>[1]),
    value: `${t(locale, `work.${w.titleKey}.title` as Parameters<typeof t>[1])} — ${getSlug(w, locale)}`,
  }));

const preselectedValue = preselectedSlug
  ? pieceOptions.find((o) => o.slug === preselectedSlug)?.value ?? ''
  : '';
---

<section class:list={["inquiry", { "is-compact": compact }]} aria-labelledby={hideHeader ? undefined : "inquiry-title"} id="inquiry">
  {!hideHeader && (
    <div class="inquiry-intro">
      <p class="eyebrow">{t(locale, 'shop.form.eyebrow')}</p>
      <h2 id="inquiry-title">{t(locale, 'shop.form.title')}</h2>
      <p class="lead">{t(locale, 'shop.form.lead')}</p>
      <p class="hint">{t(locale, 'shop.form.hint')}</p>
    </div>
  )}

  <form
    class="inquiry-form"
    action={FORMSPREE_ENDPOINT}
    method="POST"
    data-inquiry-form
    data-success-msg={t(locale, 'shop.form.success')}
    data-error-msg={t(locale, 'shop.form.error')}
    data-validation-msg={t(locale, 'shop.form.validation_pieces')}
  >
    <!-- Honeypot -->
    <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hp" aria-hidden="true" />

    <!-- Useful for Formspree subject routing -->
    <input type="hidden" name="_subject" value={`[Nautilus] Interès — ${preselectedValue || 'Peces disponibles'}`} data-subject />
    <input type="hidden" name="_language" value={locale} />

    {/* Pieces fieldset — omitted on contact page where cart already summarises selection */}
    {!hidePieces && (
      <fieldset class="field fieldset" aria-describedby="piece-hint">
        <legend>{t(locale, 'shop.form.piece_label')}</legend>
        <p class="fieldset-hint" id="piece-hint">{t(locale, 'shop.form.piece_hint')}</p>
        <div class="checks">
          {pieceOptions.length > 0 ? (
            pieceOptions.map((opt) => (
              <label class="check">
                <input
                  type="checkbox"
                  name="pieces"
                  value={opt.value}
                  data-piece-checkbox
                  data-slug={opt.slug}
                  checked={opt.slug === preselectedSlug}
                />
                <span>{opt.label}</span>
              </label>
            ))
          ) : (
            <input name="pieces" type="text" placeholder={t(locale, 'shop.form.piece_placeholder')} value={preselectedValue} required />
          )}
        </div>
        <p class="field-error" hidden data-pieces-error>{t(locale, 'shop.form.validation_pieces')}</p>
      </fieldset>
    )}
    {/* When pieces are hidden, keep hidden checkboxes so FormData still has `pieces` from cart sync */}
    {hidePieces && (
      <div hidden aria-hidden="true">
        {pieceOptions.map((opt) => (
          <input type="checkbox" name="pieces" value={opt.value} data-piece-checkbox data-slug={opt.slug} checked={opt.slug === preselectedSlug} tabindex="-1" />
        ))}
      </div>
    )}

    <div class="field-grid">
      <div class="field">
        <label for="inquiry-name">{t(locale, 'shop.form.name_label')}</label>
        <input id="inquiry-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="inquiry-email">{t(locale, 'shop.form.email_label')}</label>
        <input id="inquiry-email" name="email" type="email" autocomplete="email" required />
      </div>
    </div>

    <div class="field">
      <label for="inquiry-message">{t(locale, 'shop.form.message_label')}</label>
      <textarea id="inquiry-message" name="message" rows="4" placeholder={t(locale, 'shop.form.message_placeholder')}></textarea>
    </div>

    <button type="submit" class="submit">
      {t(locale, 'shop.form.submit')}
    </button>

    <p class="privacy">{t(locale, 'shop.form.privacy')}</p>

    <p class="form-feedback" role="status" aria-live="polite" hidden data-feedback></p>
  </form>
</section>

<script>
  const forms = document.querySelectorAll('[data-inquiry-form]');
  for (const form of forms) {
    const feedback = form.querySelector('[data-feedback]');
    const piecesError = form.querySelector('[data-pieces-error]');
    const checkboxes = form.querySelectorAll('[data-piece-checkbox]');
    const subjectInput = form.querySelector('[data-subject]');

    const updateSubject = () => {
      if (!subjectInput) return;
      const checked = Array.from(checkboxes).filter(c => c.checked);
      if (checked.length === 0) subjectInput.value = '[Nautilus] Interès — Peces disponibles';
      else if (checked.length === 1) subjectInput.value = `[Nautilus] Interès — ${checked[0].value}`;
      else subjectInput.value = `[Nautilus] Interès — ${checked.length} peces: ${checked.map(c=>c.value).join(', ')}`;
    };

    for (const cb of checkboxes) {
      cb.addEventListener('change', () => {
        if (piecesError) piecesError.hidden = true;
        updateSubject();
        // dispatch event so Shop cart can sync if on same page
        cb.dispatchEvent(new CustomEvent('pieces-change', { bubbles: true }));
      });
    }
    updateSubject();

    form.addEventListener('submit', async (e) => {
      const f = e.currentTarget;
      const action = f.getAttribute('action') ?? '';
      // validate at least one piece if checkboxes exist
      if (checkboxes.length > 0) {
        const anyChecked = Array.from(checkboxes).some(c => c.checked);
        if (!anyChecked) {
          e.preventDefault();
          if (piecesError) piecesError.hidden = false;
          const first = checkboxes[0];
          if (first) first.focus();
          return;
        }
        if (piecesError) piecesError.hidden = true;
      }

      if (!action || action.includes('xplaceholder')) return;
      e.preventDefault();
      const data = new FormData(f);
      if ((data.get('_gotcha') ?? '').toString().trim() !== '') return;
      const btn = f.querySelector('button[type="submit"]');
      const orig = btn ? btn.textContent : '';
      if (btn) { btn.setAttribute('disabled',''); btn.textContent = '…'; }
      const successMsg = f.getAttribute('data-success-msg') ?? 'Gràcies! Hem rebut el teu interès.';
      const errorMsg = f.getAttribute('data-error-msg') ?? 'No s’ha pogut enviar.';
      try {
        const res = await fetch(action, { method: 'POST', body: data, headers: { 'Accept': 'application/json' } });
        if (res.ok) {
          f.reset();
          // re-apply subject after reset (if preselected stays checked? reset clears all)
          // keep empty state
          updateSubject();
          // notify cart to re-sync
          f.dispatchEvent(new CustomEvent('inquiry-success', { bubbles: true }));
          if (feedback) {
            feedback.hidden = false;
            feedback.removeAttribute('data-error');
            feedback.textContent = successMsg;
          }
        } else { throw new Error('form error'); }
      } catch {
        if (feedback) {
          feedback.hidden = false;
          feedback.textContent = errorMsg;
          feedback.setAttribute('data-error','');
        }
      } finally {
        if (btn) { btn.removeAttribute('disabled'); if (orig) btn.textContent = orig; }
      }
    });
  }
</script>

<style>
  .inquiry {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: clamp(2rem, 5vw, 3rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    max-width: 38rem;
  }
  .is-compact {
    margin-top: 2rem;
    padding-top: 2rem;
  }
  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 62%, transparent);
  }
  h2 {
    margin: 0;
    font-family: 'Fraunces Variable', Georgia, serif;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 400;
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .lead {
    margin: 1rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--ink) 78%, transparent);
  }
  .hint {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: color-mix(in srgb, var(--ink) 56%, transparent);
    font-style: italic;
  }
  .inquiry-form {
    margin-top: 1.75rem;
    display: grid;
    gap: 1.1rem;
  }
  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
  }
  @media (max-width: 560px) {
    .field-grid { grid-template-columns: 1fr; }
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  label, .fieldset legend {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--ink) 70%, transparent);
  }
  .fieldset {
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    padding: 0.9rem 0.95rem 1rem;
    margin: 0;
  }
  .fieldset legend { padding: 0 0.4rem; }
  .fieldset-hint {
    margin: 0 0 0.7rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 60%, transparent);
  }
  .checks {
    display: grid;
    gap: 0.55rem;
  }
  .check {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink);
    cursor: pointer;
  }
  .check input[type="checkbox"] {
    appearance: auto;
    width: 1rem;
    height: 1rem;
    accent-color: var(--ink);
    margin: 0;
  }
  .check span { line-height: 1.3; }
  .field-error {
    margin: 0.5rem 0 0;
    font-size: 0.78rem;
    color: #b85c3a;
  }
  input[type="text"],
  input[type="email"],
  select,
  textarea {
    appearance: none;
    width: 100%;
    box-sizing: border-box;
    padding: 0.75rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent);
    border-radius: 0;
    background: color-mix(in srgb, var(--paper) 92%, white);
    color: var(--ink);
    font-family: inherit;
    font-size: 0.95rem;
    line-height: 1.4;
    transition: border-color 200ms ease, background 200ms ease;
  }
  textarea { resize: vertical; min-height: 5.5rem; }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  .check input:focus-visible {
    outline: 1px solid var(--ink);
    outline-offset: 0.15rem;
  }
  input[type="text"]:focus-visible,
  input[type="email"]:focus-visible,
  textarea:focus-visible {
    border-color: color-mix(in srgb, var(--ink) 45%, transparent);
    background: white;
  }
  .hp {
    position: absolute !important;
    left: -9999px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }
  .submit {
    justify-self: start;
    margin-top: 0.25rem;
    padding: 0.85rem 1.6rem;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: var(--paper);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 200ms ease, color 200ms ease, opacity 200ms ease;
  }
  .submit:hover,
  .submit:focus-visible {
    background: transparent;
    color: var(--ink);
  }
  .submit:disabled { opacity: 0.6; cursor: wait; }
  .privacy {
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--ink) 58%, transparent);
  }
  .form-feedback {
    margin: 0;
    padding: 0.75rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
    background: color-mix(in srgb, var(--paper) 88%, white);
    font-size: 0.88rem;
    line-height: 1.5;
  }
  .form-feedback[data-error] {
    border-color: #b85c3a;
  }
  @media (prefers-color-scheme: dark) {
    input[type="text"],
    input[type="email"],
    select,
    textarea {
      background: color-mix(in srgb, var(--nc-paper-dark) 88%, white 6%);
      border-color: color-mix(in srgb, var(--nc-ink-dark) 22%, transparent);
      color: var(--nc-ink-dark);
    }
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible {
      background: color-mix(in srgb, var(--nc-paper-dark) 92%, white 8%);
    }
    .form-feedback {
      background: color-mix(in srgb, var(--nc-paper-dark) 90%, white 7%);
    }
    .fieldset { border-color: color-mix(in srgb, var(--nc-ink-dark) 18%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    input, select, textarea, .submit { transition: none; }
  }
</style>
