---
import { Image } from 'astro:assets';
import { getImageAsset, imageSizes, imageWidths } from '@/lib/images';

interface Props {
  src: string; // relative path under src/assets/images without extension, e.g. "gallery/plato_en_taller_de_hoji"
  alt: string;
  loading?: 'eager' | 'lazy';
  fetchPriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  sizes?: string;
  widths?: number[];
  class?: string;
  style?: string;
}

const {
  src,
  alt,
  loading = 'lazy',
  fetchPriority,
  decoding = 'async',
  sizes = imageSizes.gallery,
  widths = imageWidths.card,
  class: className,
  style,
} = Astro.props;

const asset = getImageAsset(src);
const isEager = loading === 'eager';
---

<Image
  src={asset}
  alt={alt}
  widths={widths}
  sizes={sizes}
  loading={loading}
  decoding={decoding}
  fetchpriority={isEager ? (fetchPriority ?? 'high') : fetchPriority}
  class={className}
  style={style}
/>
