---
// Editor de contingut — només s'usa a les pàgines de desenvolupament
// (`/contingut/peces/afegir`, `/contingut/peces/editar/<id>`, i les versions es/en).
import { works, type Work } from '@/lib/content';
import { t, normalizeLocale } from '@/i18n';
import { editorStrings } from '@/dev/editor-i18n';
import { PIECE_CATEGORIES, PIECE_SIZES, categoryLabel, sizeLabel } from '@/lib/shop-discovery';
import { getRelativeLocaleUrl } from 'astro:i18n';

interface Props {
	work?: Work;
}

const { work } = Astro.props;
const editing = Boolean(work);

const locale = normalizeLocale(Astro.currentLocale);
const s = editorStrings[locale];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const galleryBase = getRelativeLocaleUrl(locale, `/${t(locale, 'gallery.path')}`);

const existing = works.map((entry) => ({
	id: entry.id,
	title: entry.title.ca,
	slug: entry.slugs.ca,
	images: entry.images.length,
}));

const statusOptions = ['inquiry', 'available', 'made_to_order', 'reserved', 'sold'] as const;
const statusLabel = (status: (typeof statusOptions)[number]) =>
	t(locale, `shop.status.${status}` as Parameters<typeof t>[1]);

const values = {
	title: {
		ca: work?.title.ca ?? '',
		es: work?.title.es ?? '',
		en: work?.title.en ?? '',
	},
	description: {
		ca: work?.description.ca ?? '',
		es: work?.description.es ?? '',
		en: work?.description.en ?? '',
	},
	slug: work?.slugs.ca ?? '',
	made: work?.made ?? 'hoji',
	category: work?.category ?? '',
	size: work?.size ?? '',
	tags: {
		ca: work?.tags?.ca ?? '',
		es: work?.tags?.es ?? '',
		en: work?.tags?.en ?? '',
	},
	madeAt: work?.madeAt ?? '',
	shop: work?.shop,
};

const clientStrings = {
	editing,
	altLabel: s.altLabel,
	badgeCover: s.badgeCover,
	badgeCropped: s.badgeCropped,
	crop: s.crop,
	cropAgain: s.cropAgain,
	cropApplied: s.cropApplied,
	revert: s.revert,
	moveUp: s.moveUp,
	moveDown: s.moveDown,
	remove: s.remove,
	errorTitle: s.errorTitle,
	errorPhoto: s.errorPhoto,
	submit: s.submit,
	submitEdit: s.submitEdit,
	submitting: s.submitting,
	statusConverting: s.statusConverting,
	statusSaved: s.statusSaved,
	viewIt: s.viewIt,
	reloadNote: s.reloadNote,
	errorCrop: s.errorCrop,
	errorSave: s.errorSave,
	errorGeneric: s.errorGeneric,
	galleryBase,
	imagesBase: `${base}images/`,
	existingImages: work ? work.images.map((image) => ({ file: image.file, alt: image.alt.ca })) : [],
};
---

<main class="editor">
	<div class="editor-inner">
		<header class="topline">
			<a class="brand" href={getRelativeLocaleUrl(locale, '/')}>nautilusceramica</a>
			<div class="topline-meta">
				<span class="tag">{s.tag}</span>
				<a class="quiet-link" href={galleryBase}>{s.back}</a>
			</div>
		</header>

		<div class="intro">
			<p class="eyebrow">{s.eyebrow}</p>
			<h1>{editing ? s.headingEdit : s.heading}</h1>
			<p class="lead">{editing ? s.leadEdit : s.lead}</p>
		</div>

		<div class="columns">
			<form id="piece-form" class="sheet" novalidate>
				{editing && <input id="piece-id" type="hidden" value={work?.id} />}
				<fieldset class="section">
					<legend class="section-title">{s.sectionPiece}</legend>
					<label class="field">
						<span class="label">{s.titleLabel} <em>{s.noteCa}</em></span>
						<input id="title-ca" name="title-ca" type="text" autocomplete="off" required placeholder="Gerro de tardor" value={values.title.ca} />
					</label>
					<div class="field-row">
						<label class="field">
							<span class="label">{s.slugLabel} <em>{s.optional}</em></span>
							<input id="slug-ca" name="slug-ca" type="text" autocomplete="off" placeholder={s.slugPlaceholder} value={values.slug} />
						</label>
						<label class="field">
							<span class="label">{s.madeLabel}</span>
							<select id="made" name="made">
								<option value="hoji" selected={values.made === 'hoji'}>{t(locale, 'work.made.hoji')}</option>
								<option value="llotja" selected={values.made === 'llotja'}>{t(locale, 'work.made.llotja')}</option>
							</select>
						</label>
					</div>
					<label class="field">
						<span class="label">{s.tagsLabel} (ca) <em>{s.optional}</em></span>
						<input id="tags-ca" type="text" autocomplete="off" value={values.tags.ca} />
						<span class="field-note">{s.tagsHint}</span>
					</label>
					<div class="field-row">
						<label class="field">
							<span class="label">{s.categoryLabel} <em>{s.optional}</em></span>
							<select id="category" name="category">
								<option value="" selected={!values.category}>{s.optional}</option>
								{PIECE_CATEGORIES.map((category) => (
									<option value={category} selected={values.category === category}>{categoryLabel(category, locale)}</option>
								))}
							</select>
						</label>
						<label class="field">
							<span class="label">{s.sizeLabel} <em>{s.optional}</em></span>
							<select id="size" name="size">
								<option value="" selected={!values.size}>{s.optional}</option>
								{PIECE_SIZES.map((size) => (
									<option value={size} selected={values.size === size}>{sizeLabel(size, locale)}</option>
								))}
							</select>
						</label>
					</div>
					<div class="field-row">
						<label class="field">
							<span class="label">{s.madeAtLabel} <em>{s.optional}</em></span>
							<input id="made-at" type="date" value={values.madeAt} />
						</label>
						<p class="field-note">{s.datesNote}</p>
					</div>
				</fieldset>

				<fieldset class="section">
					<legend class="section-title">{s.sectionDescription}</legend>
					<label class="field">
						<span class="label">{s.textLabel} <em>{s.noteCa}</em></span>
						<textarea id="description-ca" name="description-ca" rows="6" placeholder={s.textPlaceholder}>{values.description.ca}</textarea>
					</label>
				</fieldset>

				<fieldset class="section">
					<legend class="section-title">{s.sectionPhotos}</legend>
					<p class="hint">{s.photosHint}</p>
					<label class="dropzone" id="dropzone">
						<input id="file-input" type="file" accept="image/*" multiple hidden />
						<span class="dropzone-title">{s.dropTitle}</span>
						<span class="dropzone-sub">{s.dropSub}</span>
					</label>
					<ul class="shots" id="shot-list"></ul>
				</fieldset>

				<details class="section collapsible">
					<summary class="section-title">{s.sectionI18n} <span>{s.optional}</span></summary>
					<div class="collapsible-body">
						<p class="hint">{s.i18nHint}</p>
						<div class="field-row">
							<label class="field">
								<span class="label">{s.titleEs}</span>
								<input id="title-es" type="text" autocomplete="off" value={values.title.es} />
							</label>
							<label class="field">
								<span class="label">{s.titleEn}</span>
								<input id="title-en" type="text" autocomplete="off" value={values.title.en} />
							</label>
						</div>
						<label class="field">
							<span class="label">{s.descEs}</span>
							<textarea id="description-es" rows="3">{values.description.es}</textarea>
						</label>
						<label class="field">
							<span class="label">{s.descEn}</span>
							<textarea id="description-en" rows="3">{values.description.en}</textarea>
						</label>
						<div class="field-row">
							<label class="field">
								<span class="label">{s.tagsLabel} (es)</span>
								<input id="tags-es" type="text" autocomplete="off" value={values.tags.es} />
							</label>
							<label class="field">
								<span class="label">{s.tagsLabel} (en)</span>
								<input id="tags-en" type="text" autocomplete="off" value={values.tags.en} />
							</label>
						</div>
					</div>
				</details>

				<details class="section collapsible">
					<summary class="section-title">{s.sectionShop} <span>{s.optional}</span></summary>
					<div class="collapsible-body">
						<label class="check">
							<input id="shop-available" type="checkbox" checked={values.shop?.available === true} />
							<span>{s.shopAvailable}</span>
						</label>
						<div class="field-row">
							<label class="field">
								<span class="label">{s.statusLabel}</span>
								<select id="shop-status">
									{statusOptions.map((status) => (
										<option value={status} selected={values.shop?.status === status}>{statusLabel(status)}</option>
									))}
								</select>
							</label>
							<label class="field">
								<span class="label">{s.priceLabel}</span>
								<input id="shop-price" type="number" min="0" step="1" inputmode="numeric" value={values.shop?.price ?? ''} />
							</label>
						</div>
						<label class="field">
							<span class="label">{t(locale, 'shop.detail.dimensions')}</span>
							<input id="shop-dimensions" type="text" placeholder="Ø 8 · 14 cm" value={values.shop?.dimensions ?? ''} />
						</label>
					</div>
				</details>

				<div class="actions">
					<button class="submit" type="submit" id="submit">{editing ? s.submitEdit : s.submit}</button>
					<p class="status" id="form-status" role="status" aria-live="polite"></p>
				</div>
			</form>

			<aside class="sidebar">
				<section class="panel">
					<h2 class="panel-title">{s.panelExisting} <span>{existing.length}</span></h2>
					<ul class="work-list">
						{existing.map((work) => (
							<li>
								<a href={`${galleryBase}/${work.slug}`}>
									<span class="work-title">{work.title}</span>
									<span class="work-meta">{work.images} {work.images === 1 ? s.imageSingular : s.imagePlural}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
				<section class="panel">
					<h2 class="panel-title">{s.panelWhere}</h2>
					<ul class="path-list">
						<li><code>src/content/works.json</code><span>{s.whereJson}</span></li>
						<li><code>public/images/works/&lt;slug&gt;/</code><span>{s.whereImages}</span></li>
					</ul>
					<p class="hint">{s.whereHint}</p>
				</section>
			</aside>
		</div>
	</div>

	<div class="crop-layer" id="crop-layer" hidden>
		<div class="crop-dialog" role="dialog" aria-modal="true" aria-labelledby="crop-title">
			<header class="crop-header">
				<h2 id="crop-title">{s.cropTitle}</h2>
				<div class="crop-presets" id="crop-presets" role="group" aria-label={s.cropTitle}>
					<button type="button" data-aspect="0" class="is-active">{s.cropFree}</button>
					<button type="button" data-aspect="1">1:1</button>
					<button type="button" data-aspect="0.8">4:5</button>
					<button type="button" data-aspect="0.75">3:4</button>
					<button type="button" data-aspect="1.7778">16:9</button>
				</div>
			</header>
			<div class="crop-stage">
				<div class="crop-frame" id="crop-frame">
					<img id="crop-image" alt="" />
					<div class="crop-box" id="crop-box">
						<span class="crop-h" data-handle="nw"></span>
						<span class="crop-h" data-handle="ne"></span>
						<span class="crop-h" data-handle="sw"></span>
						<span class="crop-h" data-handle="se"></span>
					</div>
				</div>
			</div>
			<footer class="crop-footer">
				<p class="hint">{s.cropHint}<br />{s.cropNote}</p>
				<div class="crop-actions">
					<button type="button" class="ghost" id="crop-cancel">{s.cropCancel}</button>
					<button type="button" class="submit" id="crop-apply">{s.cropApply}</button>
				</div>
			</footer>
		</div>
	</div>

	<script is:inline type="application/json" id="editor-strings" set:html={JSON.stringify(clientStrings)}></script>

	<script>
		const S = JSON.parse(document.getElementById('editor-strings').textContent);

		const base = import.meta.env.BASE_URL.endsWith('/')
			? import.meta.env.BASE_URL
			: `${import.meta.env.BASE_URL}/`;

		const form = document.getElementById('piece-form');
		const dropzone = document.getElementById('dropzone');
		const fileInput = document.getElementById('file-input');
		const list = document.getElementById('shot-list');
		const status = document.getElementById('form-status');
		const submit = document.getElementById('submit');
		const titleInput = document.getElementById('title-ca');

		const cropLayer = document.getElementById('crop-layer');
		const cropImage = document.getElementById('crop-image');
		const cropBox = document.getElementById('crop-box');
		const cropPresets = document.getElementById('crop-presets');
		const cropApply = document.getElementById('crop-apply');
		const cropCancel = document.getElementById('crop-cancel');

		const MIN = 36;
		const MAX_EXPORT = 2400;

		let items = [];
		let busy = false;
		let crop = null;
		let drag = null;

		const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

		function setStatus(message, tone) {
			status.textContent = message;
			status.dataset.tone = tone ?? '';
		}

		function iconButton(label, glyph) {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'icon-button';
			button.setAttribute('aria-label', label);
			button.title = label;
			button.textContent = glyph;
			return button;
		}

		function textButton(label) {
			const button = document.createElement('button');
			button.type = 'button';
			button.className = 'text-button';
			button.textContent = label;
			return button;
		}

		function badge(label, className) {
			const span = document.createElement('span');
			span.className = className;
			span.textContent = label;
			return span;
		}

		function render() {
			list.textContent = '';
			items.forEach((item, index) => {
				const row = document.createElement('li');
				row.className = 'shot';
				row.dataset.index = String(index);

				const thumb = document.createElement('div');
				thumb.className = 'shot-thumb';
				const image = document.createElement('img');
				image.src = item.url;
				image.alt = '';
				thumb.append(image);

				const body = document.createElement('div');
				body.className = 'shot-body';
					const name = document.createElement('p');
					name.className = 'shot-name';
					name.textContent = item.name;
					if (index === 0) name.append(' ', badge(S.badgeCover, 'cover'));
					if (item.cropped) {
						name.append(' ', badge(S.badgeCropped, 'cover is-crop'));
						if (item.width) name.append(' ', badge(`${item.width}×${item.height}`, 'cover is-size'));
					}

				const altLabel = document.createElement('label');
				altLabel.className = 'shot-alt';
				altLabel.textContent = S.altLabel;
				const altInput = document.createElement('input');
				altInput.type = 'text';
				altInput.value = item.alt;
				altInput.autocomplete = 'off';
				altInput.addEventListener('input', () => {
					item.alt = altInput.value;
				});
				altLabel.append(altInput);

				const tools = document.createElement('div');
				tools.className = 'shot-tools';
				const cropButton = textButton(item.cropped ? S.cropAgain : S.crop);
				cropButton.dataset.crop = 'true';
				tools.append(cropButton);
				if (item.cropped) {
					const revertButton = textButton(S.revert);
					revertButton.classList.add('is-quiet');
					revertButton.dataset.revert = 'true';
					tools.append(revertButton);
				}

				body.append(name, altLabel, tools);

				const actions = document.createElement('div');
				actions.className = 'shot-actions';
				const up = iconButton(S.moveUp, '↑');
				up.dataset.move = '-1';
				up.disabled = index === 0;
				const down = iconButton(S.moveDown, '↓');
				down.dataset.move = '1';
				down.disabled = index === items.length - 1;
				const remove = iconButton(S.remove, '×');
				remove.dataset.remove = 'true';
				actions.append(up, down, remove);

				row.append(thumb, body, actions);
				list.append(row);
			});
		}

		if (S.editing && Array.isArray(S.existingImages)) {
			items = S.existingImages.map((image) => {
				const url = `${S.imagesBase}${image.file}.webp`;
				return {
					name: `${image.file.split('/').pop()}.webp`,
					source: null,
					file: null,
					existingFile: image.file,
					sourceUrl: url,
					url,
					alt: image.alt ?? '',
					cropped: false,
				};
			});
			render();
		}

		function addFiles(files) {
			const incoming = Array.from(files).filter((file) => file.type.startsWith('image/'));
			if (incoming.length === 0) return;
			for (const file of incoming) {
				const url = URL.createObjectURL(file);
				items.push({ name: file.name, source: file, file, existingFile: null, sourceUrl: url, url, alt: '', cropped: false });
			}
			render();
			setStatus('', '');
		}

		function revert(index) {
			const item = items[index];
			if (!item || !item.cropped) return;
			URL.revokeObjectURL(item.url);
			if (item.source) {
				item.file = item.source;
				item.url = URL.createObjectURL(item.source);
			} else {
				item.file = null;
				item.url = item.sourceUrl;
			}
			item.cropped = false;
			render();
		}

		list.addEventListener('click', (event) => {
			const button = event.target.closest('button');
			if (!button) return;
			const index = Number(button.closest('.shot')?.dataset.index);
			if (Number.isNaN(index)) return;

			if (button.dataset.remove) {
				URL.revokeObjectURL(items[index].url);
				URL.revokeObjectURL(items[index].sourceUrl);
				items.splice(index, 1);
				render();
				return;
			}
			if (button.dataset.crop) {
				openCrop(index);
				return;
			}
			if (button.dataset.revert) {
				revert(index);
				return;
			}
			const move = Number(button.dataset.move);
			const next = index + move;
			if (!move || next < 0 || next >= items.length) return;
			[items[index], items[next]] = [items[next], items[index]];
			render();
		});

		fileInput.addEventListener('change', () => {
			addFiles(fileInput.files);
			fileInput.value = '';
		});

		['dragenter', 'dragover'].forEach((type) => {
			dropzone.addEventListener(type, (event) => {
				event.preventDefault();
				dropzone.classList.add('is-over');
			});
		});
		['dragleave', 'drop'].forEach((type) => {
			dropzone.addEventListener(type, (event) => {
				event.preventDefault();
				dropzone.classList.remove('is-over');
			});
		});
		dropzone.addEventListener('drop', (event) => {
			if (event.dataTransfer?.files) addFiles(event.dataTransfer.files);
		});

		/* — Retall — */

		function setActiveAspect(aspect) {
			cropPresets.querySelectorAll('button').forEach((button) => {
				button.classList.toggle('is-active', Number(button.dataset.aspect) === aspect);
			});
		}

		function resetBox() {
			if (!crop || !crop.imgW || !crop.imgH) return;
			let width = crop.imgW;
			let height = crop.imgH;
			if (crop.aspect) {
				if (crop.imgW / crop.imgH > crop.aspect) {
					height = crop.imgH * 0.92;
					width = height * crop.aspect;
				} else {
					width = crop.imgW * 0.92;
					height = width / crop.aspect;
				}
			}
			crop.box = {
				x: (crop.imgW - width) / 2,
				y: (crop.imgH - height) / 2,
				w: width,
				h: height,
			};
		}

		function layoutBox() {
			if (!crop) return;
			cropBox.style.left = `${crop.box.x}px`;
			cropBox.style.top = `${crop.box.y}px`;
			cropBox.style.width = `${crop.box.w}px`;
			cropBox.style.height = `${crop.box.h}px`;
		}

		function setAspect(aspect) {
			if (!crop) return;
			crop.aspect = aspect;
			setActiveAspect(aspect);
			resetBox();
			layoutBox();
		}

		function openCrop(index) {
			const item = items[index];
			if (!item) return;
			crop = { index, aspect: 0, imgW: 0, imgH: 0, box: { x: 0, y: 0, w: 0, h: 0 } };
			cropLayer.hidden = false;
			document.body.classList.add('is-cropping');
			setActiveAspect(0);
			const init = () => {
				crop.imgW = cropImage.clientWidth;
				crop.imgH = cropImage.clientHeight;
				resetBox();
				layoutBox();
			};
			cropImage.onload = init;
			cropImage.src = item.sourceUrl;
			if (cropImage.complete && cropImage.naturalWidth > 0) init();
			cropCancel.focus();
		}

		function closeCrop() {
			crop = null;
			drag = null;
			cropLayer.hidden = true;
			document.body.classList.remove('is-cropping');
		}

		function resizeFromCorner(corner, start, dx, dy) {
			const { aspect, imgW, imgH } = crop;
			let left = start.x;
			let top = start.y;
			let right = start.x + start.w;
			let bottom = start.y + start.h;

			if (corner.includes('e')) right = clamp(right + dx, left + MIN, imgW);
			if (corner.includes('w')) left = clamp(left + dx, 0, right - MIN);
			if (corner.includes('s')) bottom = clamp(bottom + dy, top + MIN, imgH);
			if (corner.includes('n')) top = clamp(top + dy, 0, bottom - MIN);

			let width = right - left;
			let height = bottom - top;

			if (aspect) {
				if (width / height > aspect) height = width / aspect;
				else width = height * aspect;
				if (corner.includes('w')) left = right - width;
				if (corner.includes('n')) top = bottom - height;
				if (left < 0) {
					left = 0;
					width = right;
					height = width / aspect;
					if (corner.includes('n')) top = bottom - height;
				}
				if (top < 0) {
					top = 0;
					height = bottom;
					width = height * aspect;
					if (corner.includes('w')) left = right - width;
				}
				if (left + width > imgW) {
					width = imgW - left;
					height = width / aspect;
					if (corner.includes('n')) top = bottom - height;
				}
				if (top + height > imgH) {
					height = imgH - top;
					width = height * aspect;
					if (corner.includes('w')) left = right - width;
				}
			}

			crop.box = { x: left, y: top, w: Math.max(MIN, width), h: Math.max(MIN, height) };
		}

		cropBox.addEventListener('pointerdown', (event) => {
			if (!crop) return;
			const handle = event.target.dataset.handle;
			drag = {
				mode: handle ? 'resize' : 'move',
				corner: handle ?? '',
				startX: event.clientX,
				startY: event.clientY,
				box: { ...crop.box },
			};
			cropBox.setPointerCapture(event.pointerId);
			event.preventDefault();
		});

		cropBox.addEventListener('pointermove', (event) => {
			if (!drag || !crop) return;
			const dx = event.clientX - drag.startX;
			const dy = event.clientY - drag.startY;
			if (drag.mode === 'move') {
				crop.box.x = clamp(drag.box.x + dx, 0, crop.imgW - drag.box.w);
				crop.box.y = clamp(drag.box.y + dy, 0, crop.imgH - drag.box.h);
			} else {
				resizeFromCorner(drag.corner, drag.box, dx, dy);
			}
			layoutBox();
		});

		const endDrag = (event) => {
			if (!drag) return;
			drag = null;
			if (cropBox.hasPointerCapture?.(event.pointerId)) cropBox.releasePointerCapture(event.pointerId);
		};
		cropBox.addEventListener('pointerup', endDrag);
		cropBox.addEventListener('pointercancel', endDrag);

		cropPresets.addEventListener('click', (event) => {
			const button = event.target.closest('button');
			if (!button) return;
			setAspect(Number(button.dataset.aspect));
		});

		function cropToBlob(source, rect) {
			return new Promise((resolve) => {
				const image = new Image();
				image.onload = () => {
					const naturalWidth = image.naturalWidth;
					const naturalHeight = image.naturalHeight;
					const sx = Math.round(rect.x * naturalWidth);
					const sy = Math.round(rect.y * naturalHeight);
					const sw = Math.max(1, Math.round(rect.w * naturalWidth));
					const sh = Math.max(1, Math.round(rect.h * naturalHeight));
					const scale = Math.min(1, MAX_EXPORT / Math.max(sw, sh));
					const canvas = document.createElement('canvas');
					canvas.width = Math.max(1, Math.round(sw * scale));
					canvas.height = Math.max(1, Math.round(sh * scale));
					const context = canvas.getContext('2d');
					if (!context) return resolve(null);
					context.drawImage(image, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);
					canvas.toBlob(
						(blob) => resolve(blob ? { blob, width: canvas.width, height: canvas.height } : null),
						'image/png',
					);
				};
				image.onerror = () => resolve(null);
				image.src = source;
			});
		}

		cropApply.addEventListener('click', async () => {
			if (!crop || !crop.imgW || !crop.imgH) return;
			const item = items[crop.index];
			if (!item) {
				closeCrop();
				return;
			}
			const rect = {
				x: crop.box.x / crop.imgW,
				y: crop.box.y / crop.imgH,
				w: crop.box.w / crop.imgW,
				h: crop.box.h / crop.imgH,
			};
			cropApply.disabled = true;
			let result = null;
			try {
				result = await cropToBlob(item.sourceUrl, rect);
			} finally {
				cropApply.disabled = false;
			}
			if (!result) {
				closeCrop();
				setStatus(S.errorCrop, 'error');
				return;
			}
			URL.revokeObjectURL(item.url);
			const baseName = (item.source?.name ?? item.name ?? 'retall').replace(/\.[^.]+$/, '') || 'retall';
			item.file = new File([result.blob], `${baseName}.png`, { type: 'image/png' });
			item.url = URL.createObjectURL(result.blob);
			item.width = result.width;
			item.height = result.height;
			item.cropped = true;
			closeCrop();
			render();
			setStatus(`${S.cropApplied} · ${result.width} × ${result.height} px`, 'progress');
		});
		cropCancel.addEventListener('click', closeCrop);
		cropLayer.addEventListener('click', (event) => {
			if (event.target === cropLayer) closeCrop();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !cropLayer.hidden) closeCrop();
		});
		window.addEventListener('resize', () => {
			if (!crop) return;
			crop.imgW = cropImage.clientWidth;
			crop.imgH = cropImage.clientHeight;
			resetBox();
			layoutBox();
		});

		/* — Desament — */

		async function navigateWhenReady(pieceUrl, fallbackUrl) {
			// En dev la ruta de la peça es regenera en desar; esperem que estigui
			// a punt i, si no, anem a la galeria, on la peça ja hi apareix.
			for (let attempt = 0; attempt < 12; attempt += 1) {
				try {
					const response = await fetch(pieceUrl, { method: 'GET', cache: 'no-store' });
					if (response.ok) {
						window.location.assign(pieceUrl);
						return;
					}
				} catch {
					// Encara no està a punt; tornem-ho a provar.
				}
				await new Promise((resolve) => setTimeout(resolve, 250));
			}
			window.location.assign(fallbackUrl);
		}

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (busy) return;

			const titleCa = titleInput.value.trim();
			if (!titleCa) {
				setStatus(S.errorTitle, 'error');
				titleInput.focus();
				return;
			}
			if (items.length === 0) {
				setStatus(S.errorPhoto, 'error');
				dropzone.scrollIntoView({ behavior: 'smooth', block: 'center' });
				return;
			}

			const idField = document.getElementById('piece-id');
			const payload = {
				...(idField ? { id: idField.value } : {}),
				slug: { ca: document.getElementById('slug-ca').value },
				title: {
					ca: titleCa,
					es: document.getElementById('title-es').value,
					en: document.getElementById('title-en').value,
				},
				description: {
					ca: document.getElementById('description-ca').value,
					es: document.getElementById('description-es').value,
					en: document.getElementById('description-en').value,
				},
				made: document.getElementById('made').value,
				category: document.getElementById('category').value,
				size: document.getElementById('size').value,
				tags: {
					ca: document.getElementById('tags-ca').value,
					es: document.getElementById('tags-es').value,
					en: document.getElementById('tags-en').value,
				},
				madeAt: document.getElementById('made-at').value,
				images: items.map((item) =>
					item.file
						? { alt: { ca: item.alt }, upload: true }
						: { alt: { ca: item.alt }, file: item.existingFile },
				),
				shop: {
					available: document.getElementById('shop-available').checked,
					status: document.getElementById('shop-status').value,
					price: document.getElementById('shop-price').value,
					dimensions: document.getElementById('shop-dimensions').value,
				},
			};

			const body = new FormData();
			body.append('payload', JSON.stringify(payload));
			items.forEach((item, index) => {
				if (item.file) body.append(`image-${index}`, item.file, item.file.name);
			});

			busy = true;
			submit.disabled = true;
			submit.textContent = S.submitting;
			setStatus(S.statusConverting, 'progress');

			try {
				const response = await fetch(`${base}__content/works`, { method: 'POST', body });
				const result = await response.json().catch(() => ({}));
				if (!response.ok || !result.ok) {
					throw new Error(result.error ?? S.errorSave);
				}
					const url = `${S.galleryBase}/${result.slug}`;
					setStatus('', '');
					status.append(`${S.statusSaved} `);
					const link = document.createElement('a');
					link.href = url;
					link.textContent = S.viewIt;
					link.className = 'success-link';
					status.append(link);
					await navigateWhenReady(url, S.galleryBase);
				} catch (error) {
					setStatus(error.message ?? S.errorGeneric, 'error');
				} finally {
					busy = false;
					submit.disabled = false;
					submit.textContent = S.editing ? S.submitEdit : S.submit;
				}
		});

		titleInput.addEventListener('blur', () => {
			const slugField = document.getElementById('slug-ca');
			if (!slugField.value.trim() && titleInput.value.trim()) {
				slugField.value = titleInput.value
					.trim()
					.normalize('NFD')
					.replace(/[\u0300-\u036f]/g, '')
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-+|-+$/g, '');
			}
		});
	</script>

