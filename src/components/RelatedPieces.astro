---
import { type Work, getSlug } from '@/lib/content';
import { type Locale, t } from '@/i18n';
import { categoryLabel } from '@/lib/shop-discovery';
import { getRelativeLocaleUrl } from 'astro:i18n';
import sharp from 'sharp';

interface Props {
  pieces: readonly Work[];
  category?: Work['category'];
  locale: Locale;
  base: string;
}

const { pieces, category, locale, base } = Astro.props;
const copy = {
  ca: { eyebrow: 'També et pot interessar', title: 'Peces que dialoguen amb aquesta', view: 'Veure la peça' },
  es: { eyebrow: 'También te puede interesar', title: 'Piezas que dialogan con esta', view: 'Ver la pieza' },
  en: { eyebrow: 'You may also like', title: 'Pieces that speak to this one', view: 'View piece' },
} as const;
const labels = copy[locale];
const heading = category ? `${locale === 'ca' ? 'Més' : locale === 'es' ? 'Más' : 'More'} ${categoryLabel(category, locale).toLocaleLowerCase(locale)}` : labels.title;
const cards = await Promise.all(pieces.map(async (piece) => {
  const image = piece.images[0];
  let dimensions: { width?: number; height?: number } = {};
  try {
    dimensions = await sharp(`public/images/${image.file}.webp`).metadata();
  } catch {
    // A missing optional dimension must not prevent the shop page from rendering.
  }
  return { piece, image, dimensions };
}));
---

{pieces.length > 0 && (
  <section class="related" aria-labelledby="related-title">
    <div class="related-heading">
      <p class="related-eyebrow">{labels.eyebrow}</p>
      <h2 id="related-title">{heading}</h2>
    </div>
    <div class="related-grid">
      {cards.map(({ piece, image, dimensions }) => {
        const href = getRelativeLocaleUrl(locale, `/${t(locale, 'shop.path')}/${t(locale, 'shop.article.path')}/${getSlug(piece, locale)}`);
        return (
          <article class="related-card">
            <a class="related-link" href={href} aria-label={`${piece.title[locale]} — ${labels.view}`}>
              <figure>
                <img src={`${base}images/${image.file}.webp`} alt={image.alt[locale]} loading="lazy" width={dimensions.width} height={dimensions.height} sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw" />
              </figure>
              <div class="related-meta">
                <h3>{piece.title[locale]}</h3>
                <span>{labels.view} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>
        );
      })}
    </div>
  </section>
)}

<style>
  .related {
    max-width: 110rem;
    width: 100%;
    margin: clamp(1rem, 5vw, 5rem) auto 0;
    padding: clamp(2rem, 5vw, 4.5rem) 0 clamp(3rem, 8vw, 6rem);
    border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
  }
  .related-heading { display: flex; align-items: baseline; gap: 1rem 2rem; flex-wrap: wrap; margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .related-eyebrow { flex-basis: 100%; margin: 0; color: color-mix(in srgb, var(--ink) 58%, transparent); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .related h2 { margin: 0; font-family: 'Fraunces Variable', Georgia, serif; font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 400; letter-spacing: -0.04em; line-height: 0.95; }
  .related-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 3vw, 2.2rem); }
  .related-card { min-width: 0; }
  .related-link { display: block; color: inherit; text-decoration: none; }
  .related-card figure { aspect-ratio: 4 / 3; margin: 0; overflow: hidden; background: #dcd5ca; }
  .related-card img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1); }
  .related-link:hover img, .related-link:focus-visible img { transform: scale(1.025); }
  .related-meta { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; padding-top: 0.8rem; }
  .related-meta h3 { margin: 0; font-family: 'Fraunces Variable', Georgia, serif; font-size: clamp(1.1rem, 1.8vw, 1.45rem); font-weight: 400; letter-spacing: -0.03em; }
  .related-meta span { flex-shrink: 0; color: color-mix(in srgb, var(--ink) 62%, transparent); font-size: 0.64rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .related-link:focus-visible { outline: 2px solid currentColor; outline-offset: 0.35rem; }
  @media (max-width: 1000px) { .related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .related-meta { align-items: flex-start; flex-direction: column; gap: 0.4rem; } }
  @media (max-width: 700px) { .related { margin-top: 0.5rem; } .related-grid { grid-template-columns: 1fr; gap: 2rem; } .related-meta { flex-direction: row; align-items: baseline; gap: 1rem; } }
  @media (prefers-color-scheme: dark) { .related-card figure { background: #2b2822; } }
  @media (prefers-reduced-motion: reduce) { .related-card img { transition: none; } }
</style>
