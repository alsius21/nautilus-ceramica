---
import Footer from '@/components/Footer.astro';
import { BRAND_NAME, SHOP_ENABLED } from '@/consts';
import { works, getSlug } from '@/lib/content';
import { PIECE_CATEGORIES, PIECE_SIZES, categoryLabel, sizeLabel, normalizeSearch } from '@/lib/shop-discovery';
import { t, normalizeLocale, locales } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = normalizeLocale(Astro.currentLocale);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const contactHref = getRelativeLocaleUrl(locale, `/${t(locale, 'order.path')}/${t(locale, 'shop.contact.path')}`);

const availableWorks = works.filter((w) => w.shop.available);
const initialQuery = '';
const initialCategory = '';
const initialSize = '';
const presentCategories = PIECE_CATEGORIES.filter((category) => availableWorks.some((work) => work.category === category));
const presentSizes = PIECE_SIZES.filter((size) => availableWorks.some((work) => work.size === size));

const cards = availableWorks.map((work) => {
  const title = work.title[locale];
  const description = work.description[locale];
  const tags = work.tags?.[locale] ?? '';
  const category = work.category ?? '';
  const size = work.size ?? '';
  const statusLabel = t(locale, `shop.status.${work.shop.status}` as Parameters<typeof t>[1]);
  const priceLabel = work.shop.price
    ? `${work.shop.price} ${t(locale, 'shop.price.suffix')}`
    : t(locale, 'shop.price.inquiry');
  return {
    id: work.id,
    slug: getSlug(work, locale),
    title,
    status: work.shop.status,
    statusLabel,
    priceLabel,
    price: typeof work.shop.price === 'number' ? work.shop.price : null,
    hasPrice: typeof work.shop.price === 'number',
    dimensions: work.shop.dimensions ?? null,
    href: getRelativeLocaleUrl(locale, `/${t(locale, 'shop.path')}/${t(locale, 'shop.article.path')}/${getSlug(work, locale)}`),
    src: work.images[0].file,
    alt: work.images[0].alt[locale],
    category,
    size,
    search: normalizeSearch(`${title} ${description} ${tags} ${category ? categoryLabel(category, locale) : ''} ${size ? sizeLabel(size, locale) : ''}`),
  };
});
---

<main class="portfolio">
  <header class="journal-header">
    <a class="brand-name" href={getRelativeLocaleUrl(locale, '/')}>{BRAND_NAME}</a>
    <div class="header-meta">
      <nav class="page-nav" aria-label={t(locale, 'nav.label')}>
        <a href={getRelativeLocaleUrl(locale, `/${t(locale, 'gallery.path')}`)}>{t(locale, 'nav.gallery')}</a>
        <a href={getRelativeLocaleUrl(locale, `/${t(locale, 'exhibitions.path')}`)}>{t(locale, 'nav.exhibitions')}</a>
        <a href={getRelativeLocaleUrl(locale, `/${t(locale, 'shop.path')}`)} aria-current="page">{t(locale, 'nav.shop')}</a>
      </nav>
      <nav class="lang-switcher" aria-label={t(locale, 'lang.selector')}>
        {locales.map((code) => (
          <a
            href={getRelativeLocaleUrl(code, `/${t(code, 'shop.path')}`)}
            class:list={['lang-link', { 'is-current': code === locale }]}
            aria-current={code === locale ? 'page' : null}
            title={t(code, 'lang.name')}
          >
            {code}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <article class="entry is-shop-list">
    <div class="shop-main">
      {cards.length === 0 ? (
        <p class="empty">{t(locale, 'shop.empty')}</p>
      ) : (
        <>
          <div class="shop-filters" data-shop-filters hidden>
            <form class="filter-form" data-filter-form role="search">
              <label class="filter-search">
                <span>{locale === 'ca' ? 'Cerca' : locale === 'es' ? 'Buscar' : 'Search'}</span>
                <input type="search" name="q" data-filter-query value={initialQuery} placeholder={locale === 'ca' ? 'Nom, acabat o paraula clau' : locale === 'es' ? 'Nombre, acabado o palabra clave' : 'Name, finish or keyword'} autocomplete="off" />
              </label>
              <details class="filter-details">
                <summary>{locale === 'ca' ? 'Filtra per tipus i mida' : locale === 'es' ? 'Filtrar por tipo y tamaño' : 'Filter by type and size'}</summary>
                <div class="filter-selects">
                <label>
                  <span>{locale === 'ca' ? 'Tipus de peça' : locale === 'es' ? 'Tipo de pieza' : 'Piece type'}</span>
                  <select name="category" data-filter-category>
                    <option value="">{locale === 'ca' ? 'Tots els tipus' : locale === 'es' ? 'Todos los tipos' : 'All types'}</option>
                    {presentCategories.map((category) => <option value={category} selected={category === initialCategory}>{categoryLabel(category, locale)}</option>)}
                  </select>
                </label>
                <label>
                  <span>{locale === 'ca' ? 'Mida' : locale === 'es' ? 'Tamaño' : 'Size'}</span>
                  <select name="size" data-filter-size>
                    <option value="">{locale === 'ca' ? 'Totes les mides' : locale === 'es' ? 'Todos los tamaños' : 'All sizes'}</option>
                    {presentSizes.map((size) => <option value={size} selected={size === initialSize}>{sizeLabel(size, locale)}</option>)}
                  </select>
                </label>
                </div>
              </details>
              <button type="button" class="filter-clear" data-filter-clear hidden>{locale === 'ca' ? 'Neteja filtres' : locale === 'es' ? 'Limpiar filtros' : 'Clear filters'}</button>
            </form>
          </div>
          <p class="filter-empty" data-filter-empty hidden>{locale === 'ca' ? 'No hem trobat cap peça amb aquests criteris.' : locale === 'es' ? 'No hemos encontrado ninguna pieza con estos criterios.' : 'No pieces match these criteria.'}</p>
          <section class="shop-grid" aria-label={t(locale, 'shop.page.title')}>
          {cards.map((card, index) => (
            <article class="shop-card" data-card data-slug={card.id} data-search={card.search} data-category={card.category} data-size={card.size} data-price-label={card.priceLabel} data-has-price={String(card.hasPrice)} data-price={card.price ?? ''}>
              <a class="card-link" href={card.href} aria-label={`${card.title} — ${t(locale, 'shop.card.view')}`}>
                <figure>
                  <img src={`${base}images/${card.src}.webp`} alt={card.alt} loading={index === 0 ? 'eager' : 'lazy'} />
                  <span class:list={["badge", `badge-${card.status}`]}>{card.statusLabel}</span>
                </figure>
              </a>
              <div class="card-meta">
                <h2 class="card-title"><a href={card.href}>{card.title}</a></h2>
                {SHOP_ENABLED && (
                  <div class="card-bottom">
                    <span class:list={["price", { "is-inquiry": !card.hasPrice }]}>{card.priceLabel}</span>
                    {card.dimensions && <span class="dimensions">{card.dimensions}</span>}
                  </div>
                )}
                <div class="card-actions">
                  <a class="view-link" href={card.href}>{t(locale, 'shop.card.view')} →</a>
                  {SHOP_ENABLED && (
                    <button
                      type="button"
                      class="cart-btn"
                      data-cart-toggle
                      data-slug={card.id}
                      aria-pressed="false"
                      data-label-add={t(locale, 'shop.card.add')}
                      data-label-remove={t(locale, 'shop.card.remove')}
                      data-label-added={t(locale, 'shop.card.added')}
                    >
                      {t(locale, 'shop.card.add')}
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))}
          </section>
          <p class="filter-count" data-filter-count aria-live="polite"></p>
        </>
      )}
    </div>

    {SHOP_ENABLED && (
      <aside class="cart-sidebar" data-cart aria-live="polite" data-locale={locale} hidden id="cart-drawer" role="dialog" aria-modal="true" aria-label={t(locale, 'shop.cart.title')}>
        <div class="cart-head">
          <h3 class="cart-title">{t(locale, 'shop.cart.title')} — <span data-cart-count>0</span></h3>
          <div class="cart-head-actions">
            <button type="button" class="cart-clear" data-cart-clear>{t(locale, 'shop.cart.clear')}</button>
            <button type="button" class="cart-close" data-cart-close aria-label={t(locale, 'shop.cart.close')}>×</button>
          </div>
        </div>
        <p class="cart-empty" data-cart-empty>{t(locale, 'shop.cart.empty')}</p>
        <ul class="cart-list" data-cart-list hidden></ul>
        <p class="cart-total" data-cart-total hidden></p>
        <a class="cart-cta" href={contactHref} data-cart-cta hidden>{t(locale, 'shop.cart.go_to_form')} →</a>
      </aside>
    )}
  </article>

  {SHOP_ENABLED && (
    <>
      <button
        type="button"
        class="cart-fab"
        data-cart-fab
        hidden
        aria-label={t(locale, 'shop.cart.open')}
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="cart-drawer"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 7h12l-1 11H7L6 7Z"></path>
          <path d="M9 7V5a3 3 0 0 1 6 0v2"></path>
        </svg>
        <span class="cart-fab-badge" data-cart-fab-count>0</span>
      </button>
      <div class="cart-backdrop" data-cart-backdrop hidden></div>
    </>
  )}

  <Footer />
</main>

<script>
  import { normalizeSearch } from '@/lib/shop-discovery';
  type Filters = { q: string; category: string; size: string };
  const filterRoot = document.querySelector<HTMLElement>('[data-shop-filters]');
  const filterForm = document.querySelector<HTMLFormElement>('[data-filter-form]');
  const filterQuery = document.querySelector<HTMLInputElement>('[data-filter-query]');
  const filterCategory = document.querySelector<HTMLSelectElement>('[data-filter-category]');
  const filterSize = document.querySelector<HTMLSelectElement>('[data-filter-size]');
  const filterClear = document.querySelector<HTMLButtonElement>('[data-filter-clear]');
  const filterCount = document.querySelector<HTMLElement>('[data-filter-count]');
  const filterEmpty = document.querySelector<HTMLElement>('[data-filter-empty]');
  const filterDetails = document.querySelector<HTMLDetailsElement>('.filter-details');
  const filterMobile = window.matchMedia('(max-width: 768px)');
  const filterCards = [...document.querySelectorAll<HTMLElement>('[data-card]')];
  const filterLabels: Record<string, (count: number) => string> = {
    ca: (count: number) => `${count} ${count === 1 ? 'peça' : 'peces'}`,
    es: (count: number) => `${count} ${count === 1 ? 'pieza' : 'piezas'}`,
    en: (count: number) => `${count} ${count === 1 ? 'piece' : 'pieces'}`,
  };
  const filterLocale = document.documentElement.lang?.slice(0, 2) || 'ca';
  const readFilters = (): Filters => {
    const params = new URLSearchParams(window.location.search);
    return { q: params.get('q') || '', category: params.get('category') || '', size: params.get('size') || '' };
  };
  const validOption = (select: HTMLSelectElement | null, value: string): string => {
    return value && select && [...select.options].some((option) => option.value === value) ? value : '';
  };
  const sanitizeFilters = (filters: Filters): Filters => ({
    q: filters.q,
    category: validOption(filterCategory, filters.category),
    size: validOption(filterSize, filters.size),
  });
  const writeFilters = (filters: Filters): void => {
    const url = new URL(window.location.href);
    for (const [key, value] of Object.entries(filters)) value ? url.searchParams.set(key, value) : url.searchParams.delete(key);
    window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
  };
  const applyFilters = (rawFilters: Filters, updateUrl = true): void => {
    if (!filterRoot) return;
    const filters = sanitizeFilters(rawFilters);
    if (filterQuery) filterQuery.value = filters.q;
    if (filterCategory) filterCategory.value = filters.category;
    if (filterSize) filterSize.value = filters.size;
    const query = normalizeSearch(filters.q);
    let visible = 0;
    for (const card of filterCards) {
      const matches = (!query || normalizeSearch(card.dataset.search || '').includes(query))
        && (!filters.category || card.dataset.category === filters.category)
        && (!filters.size || card.dataset.size === filters.size);
      card.hidden = !matches;
      if (matches) visible += 1;
    }
    const hasFilters = Boolean(query || filters.category || filters.size);
    if (filterCount) filterCount.textContent = filterLabels[filterLocale]?.(visible) || `${visible} pieces`;
    if (filterEmpty) filterEmpty.hidden = visible !== 0 || !hasFilters;
    if (filterClear) filterClear.hidden = !hasFilters;
    if (filterDetails && filterMobile.matches && (filters.category || filters.size)) filterDetails.open = true;
    if (updateUrl || filters.category !== rawFilters.category || filters.size !== rawFilters.size) writeFilters(filters);
  };
  if (filterRoot && filterForm) {
    const syncDisclosure = (): void => {
      if (filterDetails) filterDetails.open = !filterMobile.matches || Boolean(filterCategory?.value || filterSize?.value);
    };
    syncDisclosure();
    filterMobile.addEventListener('change', syncDisclosure);
    filterRoot.hidden = false;
    applyFilters(readFilters(), false);
    filterForm.addEventListener('submit', (event) => event.preventDefault());
    const currentFilters = (): Filters => ({ q: filterQuery?.value || '', category: filterCategory?.value || '', size: filterSize?.value || '' });
    filterForm.addEventListener('input', () => applyFilters(currentFilters()));
    filterForm.addEventListener('change', () => applyFilters(currentFilters()));
    filterClear?.addEventListener('click', () => {
      applyFilters({ q: '', category: '', size: '' });
      filterQuery?.focus();
    });
    window.addEventListener('popstate', () => applyFilters(readFilters(), false));
  }
</script>

<script>
  const STORAGE_KEY = 'nautilus-cart';
  const cartEl = document.querySelector('[data-cart]');
  const fabEl = document.querySelector('[data-cart-fab]');
  const backdropEl = document.querySelector('[data-cart-backdrop]');
  if (cartEl) {
    const countEl = cartEl.querySelector('[data-cart-count]');
    const emptyEl = cartEl.querySelector('[data-cart-empty]');
    const listEl = cartEl.querySelector('[data-cart-list]');
    const totalEl = cartEl.querySelector('[data-cart-total]');
    const ctaEl = cartEl.querySelector('[data-cart-cta]');
    const clearBtn = cartEl.querySelector('[data-cart-clear]');
    const closeBtn = cartEl.querySelector('[data-cart-close]');
    const fabCountEl = fabEl?.querySelector('[data-cart-fab-count]');
    const toggles = document.querySelectorAll('[data-cart-toggle]');

    const titleMap = new Map();
    const priceMap = new Map();
    for (const card of document.querySelectorAll('[data-card]')) {
      const slug = card.getAttribute('data-slug');
      const title = card.querySelector('.card-title')?.textContent?.trim() ?? slug;
      const priceLabel = card.getAttribute('data-price-label') ?? '';
      const hasPrice = card.getAttribute('data-has-price') === 'true';
      const priceRaw = card.getAttribute('data-price');
      const price = priceRaw ? Number(priceRaw) : null;
      if (slug) {
        titleMap.set(slug, title);
        priceMap.set(slug, { priceLabel, hasPrice, price });
      }
    }

    const mqMobile = window.matchMedia('(max-width: 768px)');
    const isMobile = () => mqMobile.matches;

    const getCart = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        const arr = raw ? JSON.parse(raw) : [];
        return Array.isArray(arr) ? arr.filter(s => typeof s === 'string' && titleMap.has(s)) : [];
      } catch { return []; }
    };
    const setCart = (arr, opts = {}) => {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(arr));
      render(arr, opts);
    };

    const openDrawer = () => {
      cartEl.classList.add('is-open');
      if (backdropEl) {
        backdropEl.hidden = false;
        requestAnimationFrame(() => backdropEl.classList.add('is-open'));
      }
      if (fabEl) fabEl.setAttribute('aria-expanded', 'true');
      if (isMobile()) document.body.style.overflow = 'hidden';
    };
    const closeDrawer = () => {
      cartEl.classList.remove('is-open');
      if (backdropEl) {
        backdropEl.classList.remove('is-open');
        setTimeout(() => { if (!cartEl.classList.contains('is-open')) backdropEl.hidden = true; }, 240);
      }
      if (fabEl) fabEl.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      if (fabEl && !fabEl.hidden) fabEl.focus({ preventScroll: true });
    };
    const toggleDrawer = () => {
      if (cartEl.classList.contains('is-open')) closeDrawer();
      else openDrawer();
    };

    const render = (arr, opts = {}) => {
      const has = arr.length > 0;
      const prevHas = !cartEl.hidden;
      // visibility: hidden only when empty; otherwise keep in DOM (drawer closed on mobile)
      cartEl.hidden = !has;
      if (fabEl) {
        fabEl.hidden = !has;
        if (fabCountEl) fabCountEl.textContent = String(arr.length);
      }
      // if cart became empty, ensure drawer closed
      if (!has) {
        closeDrawer();
        if (backdropEl) backdropEl.hidden = true;
      } else if (opts.openOnAdd && isMobile() && !prevHas) {
        // first item added on mobile -> auto open
        openDrawer();
      }
      if (countEl) countEl.textContent = String(arr.length);
      if (emptyEl) emptyEl.hidden = has;
      if (listEl) listEl.hidden = !has;
      if (ctaEl) ctaEl.hidden = !has;
      if (clearBtn) clearBtn.hidden = !has;

      if (totalEl) {
        const priced = arr.map(s => priceMap.get(s)).filter(Boolean);
        const numeric = priced.filter(p => p.hasPrice && typeof p.price === 'number');
        const sum = numeric.reduce((a, p) => a + (p.price ?? 0), 0);
        const hasNumeric = numeric.length > 0;
        const hasInquiry = priced.some(p => !p.hasPrice);
        if (!has) {
          totalEl.hidden = true;
          totalEl.textContent = '';
        } else if (hasNumeric) {
          let text = `Total: ${sum} €`;
          const locale = cartEl.getAttribute('data-locale');
          if (hasInquiry) text += ' + ' + (locale === 'es' ? 'a consultar' : locale === 'en' ? 'on request' : 'a consultar');
          totalEl.textContent = text;
          totalEl.hidden = false;
        } else {
          totalEl.textContent = priced.length > 0 ? priced[0].priceLabel : '';
          totalEl.hidden = false;
        }
      }

      if (listEl) {
        listEl.innerHTML = '';
        for (const slug of arr) {
          const li = document.createElement('li');
          li.className = 'cart-item';
          const title = titleMap.get(slug) ?? slug;
          const pm = priceMap.get(slug);
          const priceLabel = pm?.priceLabel ?? '';
          li.innerHTML = `<span class="cart-item-title">${title}</span><span class="cart-item-right"><span class="cart-item-price">${priceLabel}</span><button type="button" class="cart-item-remove" data-cart-remove data-slug="${slug}" aria-label="Treure ${title}">×</button></span>`;
          listEl.appendChild(li);
        }
        for (const btn of listEl.querySelectorAll('[data-cart-remove]')) {
          btn.addEventListener('click', () => {
            const s = btn.getAttribute('data-slug');
            if (!s) return;
            setCart(getCart().filter(x => x !== s));
          });
        }
      }

      for (const btn of toggles) {
        const slug = btn.getAttribute('data-slug');
        const isIn = slug ? arr.includes(slug) : false;
        const addLabel = btn.getAttribute('data-label-add') ?? 'Afegir';
        const removeLabel = btn.getAttribute('data-label-remove') ?? 'Treure';
        btn.setAttribute('aria-pressed', String(isIn));
        btn.textContent = isIn ? removeLabel : addLabel;
        btn.classList.toggle('is-added', isIn);
      }
    };

    let cart = getCart();
    render(cart);

    for (const btn of toggles) {
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        if (!slug) return;
        const cur = getCart();
        const wasIn = cur.includes(slug);
        const next = wasIn ? cur.filter(s => s !== slug) : [...cur, slug];
        const shouldOpen = !wasIn && isMobile();
        setCart(next, { openOnAdd: shouldOpen });
        if (shouldOpen) openDrawer();
      });
    }
    if (clearBtn) clearBtn.addEventListener('click', () => setCart([]));
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    if (fabEl) fabEl.addEventListener('click', toggleDrawer);
    if (backdropEl) backdropEl.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cartEl.classList.contains('is-open')) closeDrawer();
    });
    // on resize from mobile -> desktop, reset overflow and backdrop
    mqMobile.addEventListener('change', (e) => {
      if (!e.matches) {
        document.body.style.overflow = '';
        if (backdropEl) { backdropEl.hidden = true; backdropEl.classList.remove('is-open'); }
        cartEl.classList.remove('is-open');
        if (fabEl) fabEl.setAttribute('aria-expanded', 'false');
      }
    });
    window.addEventListener('storage', () => render(getCart()));
    document.addEventListener('inquiry-success', () => setCart([]));
  }
</script>

<style>
  .portfolio {
    --ink: #29251f;
    --paper: #e8e5dc;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: 100dvh;
    padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 6vw, 7rem) 0;
    background:
      linear-gradient(115deg, rgba(217, 232, 222, 0.78), transparent 42%),
      radial-gradient(ellipse at 80% 18%, rgba(191, 214, 200, 0.5), transparent 32%),
      var(--paper);
    color: var(--ink);
  }

  .journal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 35%, transparent);
    padding-bottom: 1.25rem;
  }

  .brand-name {
    color: color-mix(in srgb, var(--ink) 85%, transparent);
    font-family: 'Fraunces Variable', Georgia, 'Times New Roman', serif;
    font-size: clamp(1.15rem, 2.4vw, 1.75rem);
    font-weight: 400;
    font-optical-sizing: auto;
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
    letter-spacing: -0.05em;
    line-height: 0.9;
    text-decoration: none;
    transition: color 240ms ease;
  }
  .lang-link {
    color: color-mix(in srgb, var(--ink) 62%, transparent);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 240ms ease;
  }
  .brand-name:hover,
  .brand-name:focus-visible,
  .lang-link:hover,
  .lang-link:focus-visible,
  .lang-link.is-current { color: var(--ink); }
  .header-meta { display: flex; align-items: baseline; gap: 2rem; }
  .page-nav { display: flex; gap: 1rem; font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .page-nav a { color: color-mix(in srgb, var(--ink) 62%, transparent); text-decoration: none; transition: color 240ms ease; }
  .page-nav a:hover, .page-nav a:focus-visible, .page-nav a[aria-current="page"] { color: var(--ink); }
  .lang-switcher { display: flex; gap: 1rem; }

  .entry {
    display: grid;
    grid-template-columns: minmax(14rem, 0.62fr) minmax(0, 1.1fr) minmax(16rem, 0.72fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    max-width: 110rem;
    width: 100%;
    margin: clamp(3rem, 9vw, 9rem) auto 0;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }
  .entry.is-shop-list {
    grid-template-columns: minmax(0, 1.9fr) minmax(16rem, 0.7fr);
    margin-top: clamp(2rem, 4vw, 4rem);
  }
  .entry-intro { position: sticky; top: 2rem; }
  .eyebrow {
    margin: 0 0 1.5rem;
    font-size: 0.68rem;
