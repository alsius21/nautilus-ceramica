---
import { BRAND_NAME } from '@/consts';

const year = new Date().getFullYear();
const instagramUrl = 'https://www.instagram.com/nautilceramica/';
---

<footer class="site-footer">
	<p class="footer-year">&copy; {year} {BRAND_NAME}</p>
	<a class="footer-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer">
		Instagram
	</a>
</footer>

<style>
	.site-footer {
		--ink: #29251f;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: auto;
		padding-top: 1.25rem;
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
		border-top: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
	}

	.footer-year {
		margin: 0;
	}

	.footer-instagram {
		color: inherit;
		text-decoration: none;
		transition: color 240ms ease;
	}

	.footer-instagram:hover,
	.footer-instagram:focus-visible {
		color: var(--ink);
	}

	@media (max-width: 640px) {
		.site-footer {
			flex-direction: column;
			gap: 0.5rem;
		}
	}

	@media (prefers-color-scheme: dark) {
		.site-footer {
			--ink: var(--nc-ink-dark);
		}
	}
</style>
