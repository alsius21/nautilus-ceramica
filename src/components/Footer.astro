---
import { BRAND_NAME } from '@/consts';
import { normalizeLocale, t } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const year = new Date().getFullYear();
const instagramUrl = 'https://www.instagram.com/nautilceramica/';
const locale = normalizeLocale(Astro.currentLocale);
const cookiesUrl = getRelativeLocaleUrl(locale, `/${t(locale, 'cookie.path')}`);
const legalUrl = getRelativeLocaleUrl(locale, `/${t(locale, 'legal.path')}`);
---

<footer class="site-footer">
	<p class="footer-year">&copy; {year} {BRAND_NAME}</p>
	<div class="footer-links">
		<a class="footer-legal" href={legalUrl}>{t(locale, 'legal.footer')}</a>
		<a class="footer-cookies" href={cookiesUrl}>{t(locale, 'cookie.footer')}</a>
		<a class="footer-instagram" href={instagramUrl} target="_blank" rel="noopener noreferrer">
			Instagram
		</a>
	</div>
</footer>

<style>
	.site-footer {
		--ink: #29251f;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		margin-top: auto;
		padding-top: 1.25rem;
		padding-bottom: clamp(1.5rem, 4vw, 3rem);
		border-top: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
	}

	.footer-year {
		margin: 0;
	}

	.footer-links {
		display: flex;
		align-items: baseline;
		gap: 2rem;
	}

	.footer-legal,
		.footer-legal:visited,
		.footer-cookies,
		.footer-cookies:visited,
		.footer-instagram,
		.footer-instagram:visited {
			color: inherit;
			text-decoration: none;
			transition: color 240ms ease;
		}

		.footer-legal:hover,
		.footer-legal:focus-visible,
		.footer-cookies:hover,
		.footer-cookies:focus-visible,
		.footer-instagram:hover,
		.footer-instagram:focus-visible,
		.footer-legal:visited:hover,
		.footer-legal:visited:focus-visible,
		.footer-cookies:visited:hover,
		.footer-cookies:visited:focus-visible,
		.footer-instagram:visited:hover,
		.footer-instagram:visited:focus-visible {
			color: var(--ink);
		}

	@media (max-width: 640px) {
		.site-footer {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.5rem;
		}

		.footer-links {
			order: -1;
		}
	}

	@media (prefers-color-scheme: dark) {
		.site-footer {
			--ink: var(--nc-ink-dark);
		}
	}

	@media (prefers-reduced-motion: reduce) {
			.footer-legal,
			.footer-legal:visited,
			.footer-cookies,
			.footer-cookies:visited,
			.footer-instagram,
			.footer-instagram:visited {
				transition: none;
			}
		}
</style>