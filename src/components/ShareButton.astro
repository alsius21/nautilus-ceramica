---
import { type Locale, t } from '@/i18n';

interface Props {
  title: string;
  text: string;
  locale: Locale;
}

const { title, text, locale } = Astro.props;
const copy = {
  defaultLabel: t(locale, 'shop.share'),
  copied: t(locale, 'shop.share.copied'),
  shared: t(locale, 'shop.share.shared'),
  error: t(locale, 'shop.share.error'),
};
---

<button
  class="share-button"
  type="button"
  aria-label={copy.defaultLabel}
  title={copy.defaultLabel}
  data-share-piece
  data-share-title={title}
  data-share-text={text}
  data-share-default={copy.defaultLabel}
  data-share-copied={copy.copied}
  data-share-shared={copy.shared}
  data-share-error={copy.error}
>
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="18" cy="5" r="2.5"></circle>
    <circle cx="6" cy="12" r="2.5"></circle>
    <circle cx="18" cy="19" r="2.5"></circle>
    <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5"></path>
  </svg>
  <span class="sr-only" data-share-label>{copy.defaultLabel}</span>
</button>

<script>
  const shareButton = document.querySelector('[data-share-piece]');

  const copyShareUrl = async (url) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(url);
      return;
    }
    const input = document.createElement('textarea');
    input.value = url;
    input.setAttribute('readonly', '');
    input.style.position = 'fixed';
    input.style.opacity = '0';
    document.body.appendChild(input);
    input.select();
    const copied = document.execCommand('copy');
    input.remove();
    if (!copied) throw new Error('copy-failed');
  };

  if (shareButton) {
    const label = shareButton.querySelector('[data-share-label]');
    const setShareLabel = (text) => {
      if (label) label.textContent = text;
      shareButton.setAttribute('aria-label', text);
      shareButton.title = text;
    };
    shareButton.addEventListener('click', async () => {
      const defaultLabel = shareButton.getAttribute('data-share-default') ?? '';
      const title = shareButton.getAttribute('data-share-title') ?? document.title;
      const text = shareButton.getAttribute('data-share-text') ?? '';
      const url = window.location.href;
      shareButton.disabled = true;
      try {
        if (navigator.share) {
          await navigator.share({ title, text, url });
          setShareLabel(shareButton.getAttribute('data-share-shared') ?? defaultLabel);
        } else {
          await copyShareUrl(url);
          setShareLabel(shareButton.getAttribute('data-share-copied') ?? defaultLabel);
        }
        window.setTimeout(() => setShareLabel(defaultLabel), 2200);
      } catch (error) {
        if (error?.name !== 'AbortError') {
          setShareLabel(shareButton.getAttribute('data-share-error') ?? defaultLabel);
          window.setTimeout(() => setShareLabel(defaultLabel), 3200);
        }
      } finally {
        shareButton.disabled = false;
      }
    });
  }
</script>

<style>
  .share-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    padding: 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    background: transparent;
    color: color-mix(in srgb, currentColor 62%, transparent);
    font: inherit;
    font-size: 0.68rem;
    line-height: 1.4;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, opacity 200ms ease;
  }
  .share-button:hover,
  .share-button:focus-visible { color: currentColor; border-color: currentColor; }
  .share-button:disabled { cursor: wait; opacity: 0.62; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (prefers-reduced-motion: reduce) { .share-button { transition: none; } }
</style>
