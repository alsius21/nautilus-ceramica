---
import WorkJournal from '@/components/WorkJournal.astro';
import Layout from '@/layouts/Layout.astro';
import { workImageFiles, works } from '@/data/works';
import { normalizeLocale, t } from '@/i18n';

export function getStaticPaths() {
	return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const title = t(locale, `work.${work.titleKey}.title` as Parameters<typeof t>[1]);
const description = t(locale, `work.${work.titleKey}.meta` as Parameters<typeof t>[1]);
const ogImage = `images/${workImageFiles[work.imageKeys[0]]}.webp`;
---

<Layout title={title} path={`/${t(locale, 'work.path')}/${work.slug}`} description={description} image={ogImage}>
	<WorkJournal work={work} />
</Layout>
