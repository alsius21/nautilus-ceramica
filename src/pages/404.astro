---
import Footer from '@/components/Footer.astro';
import Layout from '@/layouts/Layout.astro';
import { t, normalizeLocale } from '@/i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = normalizeLocale(Astro.currentLocale);
const title = t(locale, 'notfound.title');
---

<Layout title={title} noindex>
	<main class="not-found">
		<div class="panel">
			<p class="eyebrow">{t(locale, 'notfound.eyebrow')}</p>
			<h1>{title}</h1>
			<p class="body">{t(locale, 'notfound.body')}</p>
			<nav class="links" aria-label={title}>
				<a href={getRelativeLocaleUrl(locale, '/')}>{t(locale, 'notfound.home')}</a>
				<a href={getRelativeLocaleUrl(locale, `/${t(locale, 'gallery.path')}`)}>{t(locale, 'nav.gallery')}</a>
			</nav>
		</div>
		<Footer />
	</main>
</Layout>

<style>
	.not-found {
		--ink: #29251f;
		--paper: #e8e5dc;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		min-height: 100dvh;
		padding: clamp(1.5rem, 4vw, 4rem) clamp(1.25rem, 6vw, 7rem) 0;
		background:
			linear-gradient(115deg, rgba(217, 232, 222, 0.78), transparent 42%),
			radial-gradient(ellipse at 80% 18%, rgba(191, 214, 200, 0.5), transparent 32%),
			var(--paper);
		color: var(--ink);
	}

	.panel {
		flex: 1;
		display: grid;
		align-content: center;
		gap: 1.5rem;
		width: 100%;
		max-width: 46rem;
		margin: 0 auto;
		padding: clamp(3rem, 12vh, 9rem) 0;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.68rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-family: 'Fraunces Variable', Georgia, serif;
		font-size: clamp(2.5rem, 7vw, 5.5rem);
		font-weight: 400;
		font-optical-sizing: auto;
		font-variation-settings: 'SOFT' 40, 'WONK' 1;
		letter-spacing: -0.055em;
		line-height: 0.92;
	}

	.body {
		margin: 0;
		max-width: 34rem;
		font-size: clamp(0.95rem, 1.3vw, 1.1rem);
		line-height: 1.65;
		color: color-mix(in srgb, var(--ink) 78%, transparent);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1rem;
	}

	.links a {
		font-size: 0.68rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--ink);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in srgb, var(--ink) 32%, transparent);
		padding-bottom: 0.2rem;
		transition:
			color 200ms ease,
			border-color 200ms ease;
	}

	.links a:hover,
	.links a:focus-visible {
		color: color-mix(in srgb, var(--ink) 62%, transparent);
		border-color: var(--ink);
	}

	.not-found :focus-visible {
		outline: 1px solid var(--ink);
		outline-offset: 0.35rem;
	}

	@media (prefers-color-scheme: dark) {
		.not-found {
			--ink: var(--nc-ink-dark);
			--paper: var(--nc-paper-dark);
			background:
				linear-gradient(115deg, rgba(58, 92, 82, 0.42), transparent 42%),
				radial-gradient(ellipse at 80% 18%, rgba(72, 112, 96, 0.3), transparent 32%),
				var(--nc-paper-dark);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.links a {
			transition: none;
		}
	}
</style>
