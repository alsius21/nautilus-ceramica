---
import ContentEditor from '@/components/ContentEditor.astro';
import Layout from '@/layouts/Layout.astro';
import { works, type Work } from '@/lib/content';
import { editorStrings } from '@/dev/editor-i18n';
import { normalizeLocale } from '@/i18n';

export function getStaticPaths() {
	return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

interface Props {
	work: Work;
}

const { work } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const title = editorStrings[locale].headingEdit;
---

<Layout title={title}>
	<ContentEditor work={work} />
</Layout>
