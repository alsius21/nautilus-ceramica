---
import About from '@/components/About.astro';
import PageEditor from '@/components/PageEditor.astro';
import Layout from '@/layouts/Layout.astro';
import { getAbout } from '@/lib/content';
import { normalizeLocale, t } from '@/i18n';

const locale = normalizeLocale(Astro.currentLocale);
const about = getAbout(locale);
const path = `/${t(locale, 'about.path')}`;
---

<Layout title={about.title} path={path} description={about.lead}>
	<About editable />
	<PageEditor page="about" locale={locale} publishedPath={path} />
</Layout>
