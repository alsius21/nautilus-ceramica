---
import ExhibitionJournal from '@/components/ExhibitionJournal.astro';
import Layout from '@/layouts/Layout.astro';
import { exhibitions, exhibitionOgImage } from '@/lib/content';
import { normalizeLocale, t } from '@/i18n';

export function getStaticPaths() {
	return exhibitions.map((exhibition) => ({ params: { slug: exhibition.slug }, props: { exhibition } }));
}

const { exhibition } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const title = exhibition.title[locale];
const description = exhibition.meta[locale];
const ogImage = exhibitionOgImage(exhibition);
---

<Layout title={title} path={`/${t(locale, 'exhibitions.path')}/${exhibition.slug}`} description={description} image={ogImage}>
	<ExhibitionJournal exhibition={exhibition} />
</Layout>