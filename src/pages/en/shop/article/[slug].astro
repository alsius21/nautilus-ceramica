---
import ShopJournal from '@/components/ShopJournal.astro';
import Layout from '@/layouts/Layout.astro';
import { workImageFiles, works, getSlug } from '@/data/works';
import { normalizeLocale, t } from '@/i18n';

export function getStaticPaths() {
  return works.filter((w) => w.shop.available).flatMap((work) => {
    const slug = getSlug(work, 'en');
    const paths = [{ params: { slug }, props: { work } }];
    if (work.id !== slug) paths.push({ params: { slug: work.id }, props: { work } });
    return paths;
  });
}

const { work } = Astro.props;
const locale = normalizeLocale(Astro.currentLocale);
const title = t(locale, `work.${work.titleKey}.title` as Parameters<typeof t>[1]);
const description = t(locale, `work.${work.titleKey}.meta` as Parameters<typeof t>[1]);
const ogImage = `images/${workImageFiles[work.imageKeys[0]]}.webp`;
---

<Layout title={title} path={`/${t(locale, 'shop.path')}/${t(locale, 'shop.article.path')}/${getSlug(work, locale)}`} description={description} image={ogImage}>
  <ShopJournal work={work} />
</Layout>
