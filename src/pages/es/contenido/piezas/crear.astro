---
import ContentEditor from '@/components/ContentEditor.astro';
import Layout from '@/layouts/Layout.astro';
import { editorStrings } from '@/dev/editor-i18n';
import { normalizeLocale } from '@/i18n';

const locale = normalizeLocale(Astro.currentLocale);
const title = editorStrings[locale].metaTitle;
---

<Layout title={title}>
	<ContentEditor />
</Layout>
